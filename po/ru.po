msgstr "Загрузить актуальные базы geoip и geosite"

#: src/ui/pages/settings_page.ui:208
msgid "Update"
msgstr "Обновить"

#: src/ui/pages/settings_page.ui:234
msgid "Bypass LAN"
msgstr "Обход LAN (Bypass LAN)"

#: src/ui/pages/settings_page.ui:235
msgid "Do not route local traffic through VPN"
msgstr "Не маршрутизировать локальный трафик через VPN"

