\nmsgid "VPN Keys"\nmsgstr "Ключи VPN"\n\nmsgid "Proxy"\nmsgstr "Прокси"\n\nmsgid "Routing"\nmsgstr "Маршрутизация"\n\nmsgid "Settings"\nmsgstr "Настройки"\n\nmsgid "System Logs"\nmsgstr "Системные логи"\n\nmsgid "Auto-scroll"\nmsgstr "Автопрокрутка"\n\nmsgid "Copy logs"\nmsgstr "Скопировать логи"\n\nmsgid "Clear logs"\nmsgstr "Очистить логи"\n\nmsgid "Add connection"\nmsgstr "Добавить подключение"\n\nmsgid "Disconnect"\nmsgstr "Отключить"\n\nmsgid "Connection list"\nmsgstr "Список подключений"\n\nmsgid "Local proxy"\nmsgstr "Локальный прокси"\n\nmsgid "System proxy"\nmsgstr "Системный прокси"\n\nmsgid "Automatic proxy configuration for the whole system (GNOME)"\nmsgstr "Автоматическая настройка прокси для всей системы (GNOME)"\n\nmsgid "Set system proxy"\nmsgstr "Устанавливать системный прокси"\n\nmsgid "When connected, application traffic will go through the proxy"\nmsgstr "При активном подключении трафик приложений пойдет через прокси"\n\nmsgid "Inbound connections (Inbounds)"\nmsgstr "Входящие подключения (Inbounds)"\n\nmsgid "Local ports where the core proxy servers run"\nmsgstr "Локальные порты, на которых работают прокси-серверы ядра"\n\nmsgid "SOCKS5 Port"\nmsgstr "SOCKS5 Порт"\n\nmsgid "HTTP Port"\nmsgstr "HTTP Порт"\n\nmsgid "Allow connections from LAN"\nmsgstr "Разрешить подключения из LAN"\n\nmsgid "Proxy will be available for other devices in your local network"\nmsgstr "Прокси будет доступен для других устройств в вашей локальной сети"\n\nmsgid "Add domain"\nmsgstr "Добавить домен"\n\nmsgid "Clear list"\nmsgstr "Очистить список"\n\nmsgid "Export / Import"\nmsgstr "Экспорт / Импорт"\n\nmsgid "Enable custom routing"\nmsgstr "Включить пользовательскую маршрутизацию"\n\nmsgid "Use rules below to route traffic"\nmsgstr "Использовать правила ниже для направления трафика"\n\nmsgid "Search domain or rule (e.g. domain:vk.com, *.org)..."\nmsgstr "Поиск домена или правила (e.g. domain:vk.com, *.org)..."\n\nmsgid "Mode"\nmsgstr "Режим"\n\nmsgid "Exceptions (bypass VPN)"\nmsgstr "Исключения (обход VPN)"\n\nmsgid "Inclusions (VPN only)"\nmsgstr "Включения (только VPN)"\n\nmsgid "Domains and IP addresses"\nmsgstr "Домены и IP адреса"\n\nmsgid "Import from file..."\nmsgstr "Импорт из файла..."\n\nmsgid "Export to file..."\nmsgstr "Экспорт в файл..."\n\nmsgid "General"\nmsgstr "Общие"\n\nmsgid "Language"\nmsgstr "Язык (Language)"\n\nmsgid "Application restart required"\nmsgstr "Требуется перезапуск приложения (Requires restart)"\n\nmsgid "System default"\nmsgstr "Системный (System)"\n\nmsgid "Russian"\nmsgstr "Русский"\n\nmsgid "Run at startup"\nmsgstr "Запускать при старте системы"\n\nmsgid "Automatically start application in the background"\nmsgstr "Автоматически запускать приложение в фоновом режиме"\n\nmsgid "Connect on startup"\nmsgstr "Подключаться при запуске"\n\nmsgid "Restore last active connection"\nmsgstr "Восстанавливать последнее активное подключение"\n\nmsgid "Notifications"\nmsgstr "Уведомления"\n\nmsgid "Show notifications on connection status change"\nmsgstr "Показывать уведомления при смене статуса подключения"\n\nmsgid "Streamer mode"\nmsgstr "Режим стримера"\n\nmsgid "Hide IP addresses and sensitive information in the interface"\nmsgstr "Скрывать IP-адреса и конфиденциальную информацию в интерфейсе"\n\nmsgid "Core"\nmsgstr "Ядро (Core)"\n\nmsgid "Select the routing engine used for connection"\nmsgstr "Выберите движок маршрутизации, используемый для подключения"\n\nmsgid "Used core"\nmsgstr "Используемое ядро"\n\nmsgid "Xray-core or Sing-box"\nmsgstr "Xray-core или Sing-box"\n\nmsgid "Core version"\nmsgstr "Версия ядра"\n\nmsgid "Unknown"\nmsgstr "Неизвестно"\n\nmsgid "TUN mode"\nmsgstr "Режим TUN"\n\nmsgid "Redirect all system traffic through a virtual interface (Requires Root)"\nmsgstr "Перенаправлять весь системный трафик через виртуальный интерфейс (Требуется Root)"\n\nmsgid "Network and Routing"\nmsgstr "Сеть и Маршрутизация"\n\nmsgid "Sniffing (Packet analysis)"\nmsgstr "Sniffing (Анализ пакетов)"\n\nmsgid "Determine domain from traffic (required for routing)"\nmsgstr "Определять домен из трафика (требуется для маршрутизации)"\n\nmsgid "Domain Strategy"\nmsgstr "Стратегия доменов (Domain Strategy)"\n\nmsgid "AsIs"\nmsgstr "AsIs (Как есть)"\n\nmsgid "Bypass LAN"\nmsgstr "Обход LAN (Bypass LAN)"\n\nmsgid "Do not route local traffic through VPN"\nmsgstr "Не маршрутизировать локальный трафик через VPN"\n\nmsgid "Return fake IPs (improves speed but breaks some apps)"\nmsgstr "Возвращать поддельные IP (улучшает скорость, но ломает некоторые приложения)"\n\nmsgid "Multiplexing (Mux)"\nmsgstr "Мультиплексирование (Mux)"\n\nmsgid "Speeds up connections but may cause instability"\nmsgstr "Ускоряет соединения, но может вызвать нестабильность"\n\nmsgid "Fragmentation (Fragment)"\nmsgstr "Фрагментация (Fragment)"\n\nmsgid "Split packets to bypass DPI (TCP/TLS only)"\nmsgstr "Разделять пакеты для обхода DPI (Только для TCP/TLS)"\n\nmsgid "Backup"\nmsgstr "Резервное копирование"\n\nmsgid "Import settings"\nmsgstr "Импорт настроек"\n\nmsgid "Load profiles and settings from file"\nmsgstr "Загрузить профили и настройки из файла"\n\nmsgid "Export settings"\nmsgstr "Экспорт настроек"\n\nmsgid "Save current configuration to file"\nmsgstr "Сохранить текущую конфигурацию в файл"\n\nmsgid "Diagnostics"\nmsgstr "Диагностика"\n\nmsgid "Logging level"\nmsgstr "Уровень логирования"\n\nmsgid "View logs"\nmsgstr "Просмотр логов"\n\nmsgid "Open console with real-time logs"\nmsgstr "Открыть консоль с логами в реальном времени"\n\nmsgid "Open logs folder"\nmsgstr "Открыть папку логов"\n\nmsgid "Open system folder with log files"\nmsgstr "Открыть системную папку с файлами журналов"\n\nmsgid "Reset settings"\nmsgstr "Сбросить настройки"\n\nmsgid "Delete all saved data (danger zone)"\nmsgstr "Удалить все сохраненные данные (опасная зона)"\n\nmsgid "Mark-Vless Connected"\nmsgstr "Mark-Vless Подключено"\n\nmsgid "All logs"\nmsgstr "Все логи"\n\nmsgid "Application logs"\nmsgstr "Логи приложения"\n\nmsgid "Core logs"\nmsgstr "Логи ядра"\n\nmsgid "Domain already exists in the list"\nmsgstr "Домен уже существует в списке"\n\nmsgid "Invalid domain format"\nmsgstr "Некорректный формат домена"\n\nmsgid "Application restart required to apply language"\nmsgstr "Требуется перезапуск приложения для применения языка"\n\nmsgid "{bin_name} not found"\nmsgstr "{bin_name} не найден"\n\nmsgid "Connection error"\nmsgstr "Ошибка соединения"\n\nmsgid "Unknown error. Please check System logs."\nmsgstr "Неизвестная ошибка. Пожалуйста, проверьте Системные логи."\n\nmsgid "Connection failure"\nmsgstr "Сбой подключения"\n\nmsgid "Failed to connect to the selected VPN key."\nmsgstr "Не удалось подключиться к выбранному VPN ключу."\n\nmsgid "Connecting..."\nmsgstr "Подключение..."\n\nmsgid "Configuration error"\nmsgstr "Ошибка конфигурации"\n\nmsgid "Core startup error"\nmsgstr "Ошибка запуска ядра"\n\nmsgid "Server address"\nmsgstr "Адрес сервера"\n\nmsgid "Network"\nmsgstr "Сеть"\n\nmsgid "Security"\nmsgstr "Безопасность"\n\nmsgid "Public key"\nmsgstr "Публичный ключ"\n\nmsgid "Edit VPN key"\nmsgstr "Редактировать VPN ключ"\n\nmsgid "Connection"\nmsgstr "Соединение"\n\nmsgid "{} (Copy)"\nmsgstr "{} (Копия)"\n\nmsgid "Delete VPN key"\nmsgstr "Удалить VPN ключ"\n\nmsgid "Add VPN key"\nmsgstr "Добавить VPN ключ"\n\nmsgid "Are you sure you want to delete '{key_name}'?"\nmsgstr "Вы уверены, что хотите удалить '{key_name}'?"\n\nmsgid "Starting core {bin_name}..."\nmsgstr "Запуск ядра {bin_name}..."\n\nmsgid "Stopping core process..."\nmsgstr "Остановка процесса ядра..."\n\nmsgid "Core process terminated."\nmsgstr "Процесс ядра завершен."\n\nmsgid "System is going to sleep! Suspending VPN monitoring."\nmsgstr "Система переходит в спящий режим! Приостановка мониторинга VPN."\n\nmsgid "System woke up! Resuming VPN monitoring."\nmsgstr "Система проснулась! Возобновление мониторинга VPN."\n\nmsgid "Core process crash detected! Disconnecting..."\nmsgstr "Обнаружено падение процесса ядра! Отключение..."\n\nmsgid "Connection timeout (over 12 sec)."\nmsgstr "Таймаут подключения (более 12 сек)."\n\nmsgid "Failed to parse key for configuration generation"\nmsgstr "Не удалось распарсить ключ для генерации конфигурации"\n\nmsgid "Connecting to VPN key: {}"\nmsgstr "Подключение к VPN ключу: {}"\n\nmsgid "Failed to start backend: {e}"\nmsgstr "Не удалось запустить бэкенд: {e}"\n\nmsgid "Backend successfully started"\nmsgstr "Бэкенд успешно запущен"\n\nmsgid "Key parsing error: {e}"\nmsgstr "Ошибка парсинга ключа: {e}"\n\nmsgid "Key parsing error from buffer: {e}"\nmsgstr "Ошибка парсинга ключа из буфера: {e}"\n\nmsgid "Disconnecting VPN"\nmsgstr "Отключение VPN"\n\nmsgid "Error stopping backend: {e}"\nmsgstr "Ошибка остановки бэкенда: {e}"\n\nmsgid "Parser should accept valid Base64 Vmess"\nmsgstr "Парсер должен принимать валидный Base64 Vmess"\n\nmsgid "Parser should return Err on invalid Base64"\nmsgstr "Парсер должен возвращать Err на невалидный Base64"\n\nmsgid "Core process unexpectedly terminated. Log details:\n\n{error_details}"\nmsgstr "Процесс ядра неожиданно завершился. Детали лога:\n\n{error_details}"\n\nmsgid "Failed to create temporary file"\nmsgstr "Не удалось создать временный файл"\n\nmsgid "Failed to write configuration"\nmsgstr "Не удалось записать конфигурацию"\n\nmsgid "Core {bin_name} not found in the system.\n\nPlease install it (e.g., via your package manager) or select another core in Settings."\nmsgstr "Ядро {bin_name} не найдено в системе.\n\nПожалуйста, установите его (например, через ваш пакетный менеджер) или выберите другое ядро в Настройках."\n\nmsgid "TUN mode is enabled, but the core {bin_name} lacks necessary permissions (cap_net_admin).\n\nRun in terminal:\nsudo setcap cap_net_admin=ep {core_path}"\nmsgstr "Режим TUN включен, но ядро {bin_name} не имеет необходимых прав (cap_net_admin).\n\nВыполните в терминале:\nsudo setcap cap_net_admin=ep {core_path}"\n
