<interface domain="vrxx">
  <requires lib="gtk" version="4.0"/>
  <requires lib="Adw" version="1.0"/>

  <!--
    ============================================================================
    ГЛАВНОЕ ОКНО ПРИЛОЖЕНИЯ VRXX (VrxxWindow)
    ============================================================================

    АРХИТЕКТУРА И МАКЕТ ИНТЕРФЕЙСА:
    ┌──────────────────────────────────────────────────────────────────────────┐
    │ AdwApplicationWindow (VrxxWindow: 960x650, адаптивный мин. 360x500)      │
    │ └─ AdwToastOverlay (toast_overlay: всплывающие уведомления)             │
    │    └─ AdwNavigationSplitView (split_view: боковая панель + контент)      │
    │       ├─ SIDEBAR (Боковая навигация, ширина 240-300px):                  │
    │       │  ├─ AdwHeaderBar (Шапка сайдбара: заголовок "Vrxx")             │
    │       │  ├─ GtkListBox (navigation_list: список страниц)                 │
    │       │  │  ├─ [VPN Keys] -> page_vpn                                    │
    │       │  │  ├─ [Proxy]    -> page_proxy                                  │
    │       │  │  ├─ [Routing]  -> page_routing                                │
    │       │  │  └─ [Settings] -> page_settings                               │
    │       │  └─ GtkMenuButton (active_connection_btn: статус внизу сайдбара)│
    │       │     └─ GtkPopover (active_connection_popover: карточка статуса) │
    │       │        ├─ Инфо о сервере, протокол, геолокация                   │
    │       │        ├─ Метрики: пинг, трафик (↓/↑)                            │
    │       │        └─ Кнопка быстрого отключения (win.disconnect)            │
    │       └─ CONTENT (Основная рабочая область):                             │
    │          └─ GtkStack (view_stack: переключение страниц)                  │
    │             ├─ VrxxVpnPage      (Управление профилями и ключами)         │
    │             ├─ VrxxProxyPage    (Настройки системного прокси)            │
    │             ├─ VrxxRoutingPage  (Правила маршрутизации трафика)          │
    │             └─ VrxxSettingsPage (Глобальные параметры и ядро)            │
    └──────────────────────────────────────────────────────────────────────────┘
  -->

  <template class="VrxxWindow" parent="AdwApplicationWindow">
    <property name="title" translatable="yes">Vrxx</property>
    <property name="icon-name">ru.mark.vrxx</property>
    <property name="default-width">960</property>
    <property name="default-height">650</property>
    <property name="width-request">360</property>
    <property name="height-request">500</property>

    <!-- Адаптивная точка останова: при ширине <= 600sp боковая панель скрывается в мобильный режим -->
    <child>
      <object class="AdwBreakpoint">
        <condition>max-width: 600sp</condition>
        <setter object="split_view" property="collapsed">True</setter>
      </object>
    </child>

    <property name="content">
      <!-- Слой всплывающих уведомлений поверх всего окна -->
      <object class="AdwToastOverlay" id="toast_overlay">
        <property name="child">

          <!-- Разделитель: Боковая панель + Контентная область -->
          <object class="AdwNavigationSplitView" id="split_view">
            <property name="min-sidebar-width">240</property>
            <property name="max-sidebar-width">300</property>
            <property name="sidebar-width-fraction">0.25</property>

            <!-- =============================================================== -->
            <!-- 1. БОКОВАЯ ПАНЕЛЬ НАВИГАЦИИ (SIDEBAR)                           -->
            <!-- =============================================================== -->
            <property name="sidebar">
              <object class="AdwNavigationPage">
                <property name="title" translatable="yes">Menu</property>
                <property name="child">
                  <object class="AdwToolbarView">

                    <!-- Шапка боковой панели -->
                    <child type="top">
                      <object class="AdwHeaderBar">
                        <property name="title-widget">
                          <object class="AdwWindowTitle">
                            <property name="title" translatable="yes">Vrxx</property>
                          </object>
                        </property>
                      </object>
                    </child>

                    <!-- Содержимое боковой панели: список разделов и виджет активного подключения -->
                    <property name="content">
                      <object class="GtkBox">
                        <property name="orientation">vertical</property>

                        <!-- Список разделов приложения -->
                        <child>
                          <object class="GtkScrolledWindow">
                            <property name="vexpand">True</property>
                            <property name="hscrollbar-policy">never</property>
                            <property name="child">
                              <object class="GtkListBox" id="navigation_list">
                                <property name="selection-mode">single</property>
                                <property name="activate-on-single-click">True</property>
                                <style><class name="navigation-sidebar"/></style>
                                <property name="margin-top">12</property>
                                <property name="margin-bottom">12</property>
                                <property name="margin-start">12</property>
                                <property name="margin-end">12</property>

                                <!-- Раздел: VPN Ключи -->
                                <child>
                                  <object class="AdwActionRow">
                                    <property name="title" translatable="yes">VPN Keys</property>
                                    <property name="icon-name">key5-symbolic</property>
                                    <property name="name">page_vpn</property>
                                  </object>
                                </child>

                                <!-- Раздел: Системный прокси -->
                                <child>
                                  <object class="AdwActionRow">
                                    <property name="title" translatable="yes">Proxy</property>
                                    <property name="icon-name">preferences-system-network-proxy-symbolic</property>
                                    <property name="name">page_proxy</property>
                                  </object>
                                </child>

                                <!-- Раздел: Маршрутизация -->
                                <child>
                                  <object class="AdwActionRow">
                                    <property name="title" translatable="yes">Routing</property>
                                    <property name="icon-name">funnel-symbolic</property>
                                    <property name="name">page_routing</property>
                                  </object>
                                </child>

                                <!-- Раздел: Настройки -->
                                <child>
                                  <object class="AdwActionRow">
                                    <property name="title" translatable="yes">Settings</property>
                                    <property name="icon-name">emblem-system-symbolic</property>
                                    <property name="name">page_settings</property>
                                  </object>
                                </child>

                              </object>
                            </property>
                          </object>
                        </child>

                        <!-- ========================================================= -->
                        <!-- 2. ПАНЕЛЬ ТЕКУЩЕГО ПОДКЛЮЧЕНИЯ (ВНИЗУ САЙДБАРА)          -->
                        <!-- ========================================================= -->
                        <child>
                          <object class="GtkMenuButton" id="active_connection_btn">
                            <property name="visible">False</property>
                            <property name="valign">end</property>
                            <property name="margin-start">8</property>
                            <property name="margin-end">8</property>
                            <property name="margin-bottom">8</property>
                            <property name="margin-top">4</property>
                            <style><class name="flat"/></style>

                            <!-- Внешний вид кнопки активного статуса -->
                            <property name="child">
                              <object class="GtkBox">
                                <property name="orientation">horizontal</property>
                                <property name="spacing">8</property>
                                <!-- Спиннер подключения -->
                                <child>
                                  <object class="GtkSpinner" id="active_status_spinner">
                                    <property name="visible">False</property>
                                  </object>
                                </child>
                                <!-- Иконка щита/статуса -->
                                <child>
                                  <object class="GtkImage" id="active_status_icon">
                                    <property name="icon-name">network-vpn-symbolic</property>
                                    <property name="pixel-size">18</property>
                                    <style><class name="success"/></style>
                                  </object>
                                </child>
                                <!-- Текстовый блок: Имя сервера и таймер подключения -->
                                <child>
                                  <object class="GtkBox">
                                    <property name="orientation">vertical</property>
                                    <property name="valign">center</property>
                                    <property name="spacing">2</property>
                                    <child>
                                      <object class="GtkLabel" id="active_server_name">
                                        <property name="label">Server Name</property>
                                        <property name="halign">start</property>
                                        <property name="ellipsize">end</property>
                                        <property name="max-width-chars">14</property>
                                        <style>
                                          <class name="caption"/>
                                          <class name="heading"/>
                                        </style>
                                      </object>
                                    </child>
                                    <child>
                                      <object class="GtkLabel" id="active_connection_timer">
                                        <property name="label" translatable="yes">Connected</property>
                                        <property name="halign">start</property>
                                        <property name="ellipsize">end</property>
                                        <style>
                                          <class name="caption"/>
                                          <class name="dim-label"/>
                                          <class name="numeric"/>
                                        </style>
                                      </object>
                                    </child>
                                  </object>
                                </child>
                              </object>
                            </property>

                            <!-- Всплывающее окно подробной информации (Popover) -->
                            <property name="popover">
                              <object class="GtkPopover" id="active_connection_popover">
                                <property name="child">
                                  <object class="GtkBox">
                                    <property name="orientation">vertical</property>
                                    <property name="spacing">12</property>
                                    <property name="margin-top">12</property>
                                    <property name="margin-bottom">12</property>
                                    <property name="margin-start">12</property>
                                    <property name="margin-end">12</property>
                                    <property name="width-request">300</property>

                                    <!-- Заголовок всплывающего окна -->
                                    <child>
                                      <object class="GtkBox">
                                        <property name="orientation">horizontal</property>
                                        <property name="spacing">10</property>
                                        <child>
                                          <object class="GtkSpinner" id="active_popover_spinner">
                                            <property name="visible">False</property>
                                          </object>
                                        </child>
                                        <child>
                                          <object class="GtkImage" id="active_popover_icon">
                                            <property name="icon-name">network-vpn-symbolic</property>
                                            <property name="pixel-size">24</property>
                                            <style>
                                              <class name="success"/>
                                            </style>
                                          </object>
                                        </child>
                                        <child>
                                          <object class="GtkBox">
                                            <property name="orientation">vertical</property>
                                            <property name="valign">center</property>
                                            <property name="spacing">2</property>
                                            <child>
                                              <object class="GtkLabel" id="active_popover_server">
                                                <property name="label">Server Name</property>
                                                <property name="halign">start</property>
                                                <property name="ellipsize">end</property>
                                                <style>
                                                  <class name="title-5"/>
                                                  <class name="heading"/>
                                                </style>
                                              </object>
                                            </child>
                                            <child>
                                              <object class="GtkLabel" id="active_popover_status_subtitle">
                                                <property name="label" translatable="yes">Active Connection</property>
                                                <property name="halign">start</property>
                                                <style>
                                                  <class name="caption"/>
                                                  <class name="dim-label"/>
                                                  <class name="numeric"/>
                                                </style>
                                              </object>
                                            </child>
                                          </object>
                                        </child>
                                      </object>
                                    </child>

                                    <!-- Карточка 1: Детали подключения (Протокол, Режим, Локация, Хост) -->
                                    <child>
                                      <object class="GtkBox">
                                        <property name="orientation">vertical</property>
                                        <property name="spacing">6</property>
                                        <style>
                                          <class name="card"/>
                                        </style>

                                        <!-- Протокол и режим работы -->
                                        <child>
                                          <object class="GtkBox">
                                            <property name="orientation">horizontal</property>
                                            <property name="spacing">8</property>
                                            <property name="margin-top">10</property>
                                            <property name="margin-bottom">6</property>
                                            <property name="margin-start">12</property>
                                            <property name="margin-end">12</property>
                                            <child>
                                              <object class="GtkImage">
                                                <property name="icon-name">network-server-symbolic</property>
                                                <property name="pixel-size">16</property>
                                                <style>
                                                  <class name="dim-label"/>
                                                </style>
                                              </object>
                                            </child>
                                            <child>
                                              <object class="GtkLabel" id="active_popover_protocol">
                                                <property name="label">VLESS</property>
                                                <property name="halign">start</property>
                                                <property name="hexpand">True</property>
                                                <style>
                                                  <class name="caption"/>
                                                  <class name="heading"/>
                                                </style>
                                              </object>
                                            </child>
                                            <child>
                                              <object class="GtkLabel" id="active_popover_mode">
                                                <property name="label">TUN Mode</property>
                                                <property name="halign">end</property>
                                                <style>
                                                  <class name="caption"/>
                                                  <class name="dim-label"/>
                                                </style>
                                              </object>
                                            </child>
                                          </object>
                                        </child>

                                        <child>
                                          <object class="GtkSeparator">
                                            <property name="margin-start">12</property>
                                            <property name="margin-end">12</property>
                                          </object>
                                        </child>

                                        <!-- Геолокация сервера -->
                                        <child>
                                          <object class="GtkBox">
                                            <property name="orientation">horizontal</property>
                                            <property name="spacing">8</property>
                                            <property name="margin-top">4</property>
                                            <property name="margin-bottom">4</property>
                                            <property name="margin-start">12</property>
                                            <property name="margin-end">12</property>
                                            <child>
                                              <object class="GtkImage">
                                                <property name="icon-name">mark-location-symbolic</property>
                                                <property name="pixel-size">16</property>
                                                <style>
                                                  <class name="dim-label"/>
                                                </style>
                                              </object>
                                            </child>
                                            <child>
                                              <object class="GtkLabel" id="active_popover_location">
                                                <property name="label">Unknown Location</property>
                                                <property name="halign">start</property>
                                                <property name="ellipsize">end</property>
                                                <style>
                                                  <class name="caption"/>
                                                </style>
                                              </object>
                                            </child>
                                          </object>
                                        </child>

                                        <child>
                                          <object class="GtkSeparator">
                                            <property name="margin-start">12</property>
                                            <property name="margin-end">12</property>
                                          </object>
                                        </child>

                                        <!-- IP-адрес или хост сервера -->
                                        <child>
                                          <object class="GtkBox">
                                            <property name="orientation">horizontal</property>
                                            <property name="spacing">8</property>
                                            <property name="margin-top">4</property>
                                            <property name="margin-bottom">10</property>
                                            <property name="margin-start">12</property>
                                            <property name="margin-end">12</property>
                                            <child>
                                              <object class="GtkImage">
                                                <property name="icon-name">computer-symbolic</property>
                                                <property name="pixel-size">16</property>
                                                <style>
                                                  <class name="dim-label"/>
                                                </style>
                                              </object>
                                            </child>
                                            <child>
                                              <object class="GtkLabel" id="active_popover_host">
                                                <property name="label">0.0.0.0</property>
                                                <property name="halign">start</property>
                                                <property name="ellipsize">end</property>
                                                <style>
                                                  <class name="caption"/>
                                                  <class name="monospace"/>
                                                </style>
                                              </object>
                                            </child>
                                          </object>
                                        </child>
                                      </object>
                                    </child>

                                    <!-- Карточка 2: Телеметрия (Задержка/Пинг и счетчики трафика) -->
                                    <child>
                                      <object class="GtkBox">
                                        <property name="orientation">vertical</property>
                                        <property name="spacing">6</property>
                                        <style>
                                          <class name="card"/>
                                        </style>

                                        <!-- Задержка (Пинг) -->
                                        <child>
                                          <object class="GtkBox">
                                            <property name="orientation">horizontal</property>
                                            <property name="spacing">8</property>
                                            <property name="margin-top">10</property>
                                            <property name="margin-bottom">4</property>
                                            <property name="margin-start">12</property>
                                            <property name="margin-end">12</property>
                                            <child>
                                              <object class="GtkImage">
                                                <property name="icon-name">network-cellular-signal-excellent-symbolic</property>
                                                <property name="pixel-size">16</property>
                                                <style>
                                                  <class name="dim-label"/>
                                                </style>
                                              </object>
                                            </child>
                                            <child>
                                              <object class="GtkLabel" id="active_popover_ping">
                                                <property name="label">Ping: -</property>
                                                <property name="halign">start</property>
                                                <style>
                                                  <class name="caption"/>
                                                  <class name="numeric"/>
                                                </style>
                                              </object>
                                            </child>
                                          </object>
                                        </child>

                                        <child>
                                          <object class="GtkSeparator">
                                            <property name="margin-start">12</property>
                                            <property name="margin-end">12</property>
                                          </object>
                                        </child>

                                        <!-- Объем переданного трафика (Скачано / Загружено) -->
                                        <child>
                                          <object class="GtkBox">
                                            <property name="orientation">horizontal</property>
                                            <property name="spacing">8</property>
                                            <property name="margin-top">4</property>
                                            <property name="margin-bottom">10</property>
                                            <property name="margin-start">12</property>
                                            <property name="margin-end">12</property>
                                            <child>
                                              <object class="GtkImage">
                                                <property name="icon-name">folder-download-symbolic</property>
                                                <property name="pixel-size">16</property>
                                                <style>
                                                  <class name="dim-label"/>
                                                </style>
                                              </object>
                                            </child>
                                            <child>
                                              <object class="GtkLabel" id="active_server_traffic">
                                                <property name="label">↓ 0 B | ↑ 0 B</property>
                                                <property name="halign">start</property>
                                                <style>
                                                  <class name="caption"/>
                                                  <class name="numeric"/>
                                                </style>
                                              </object>
                                            </child>
                                          </object>
                                        </child>
                                      </object>
                                    </child>

                                    <!-- Кнопка быстрого отключения VPN -->
                                    <child>
                                      <object class="GtkButton">
                                        <property name="action-name">win.disconnect</property>
                                        <style>
                                          <class name="destructive-action"/>
                                        </style>
                                        <child>
                                          <object class="GtkBox">
                                            <property name="orientation">horizontal</property>
                                            <property name="halign">center</property>
                                            <property name="valign">center</property>
                                            <property name="spacing">8</property>
                                            <child>
                                              <object class="GtkImage">
                                                <property name="icon-name">network-offline-symbolic</property>
                                                <property name="pixel-size">16</property>
                                              </object>
                                            </child>
                                            <child>
                                              <object class="GtkLabel">
                                                <property name="label" translatable="yes">Disconnect</property>
                                              </object>
                                            </child>
                                          </object>
                                        </child>
                                      </object>
                                    </child>
                                  </object>
                                </property>
                              </object>
                            </property>
                          </object>
                        </child>
                      </object>
                    </property>
                  </object>
                </property>
              </object>
            </property>

            <!-- =============================================================== -->
            <!-- 3. ОСНОВНАЯ КОНТЕНТНАЯ ОБЛАСТЬ (CONTENT VIEW STACK)             -->
            <!-- =============================================================== -->
            <property name="content">
              <object class="AdwNavigationPage">
                <property name="title" translatable="yes">Content</property>
                <property name="child">
                  <object class="GtkStack" id="view_stack">
                    <property name="transition-type">crossfade</property>
                    <property name="transition-duration">140</property>

                    <!-- Страница: Список VPN-ключей и управление -->
                    <child>
                      <object class="GtkStackPage">
                        <property name="name">page_vpn</property>
                        <property name="child">
                          <object class="VrxxVpnPage"/>
                        </property>
                      </object>
                    </child>

                    <!-- Страница: Настройки системного прокси -->
                    <child>
                      <object class="GtkStackPage">
                        <property name="name">page_proxy</property>
                        <property name="child">
                          <object class="VrxxProxyPage"/>
                        </property>
                      </object>
                    </child>

                    <!-- Страница: Маршрутизация трафика -->
                    <child>
                      <object class="GtkStackPage">
                        <property name="name">page_routing</property>
                        <property name="child">
                          <object class="VrxxRoutingPage"/>
                        </property>
                      </object>
                    </child>

                    <!-- Страница: Общие настройки и конфигурация ядра -->
                    <child>
                      <object class="GtkStackPage">
                        <property name="name">page_settings</property>
                        <property name="child">
                          <object class="VrxxSettingsPage"/>
                        </property>
                      </object>
                    </child>

                  </object>
                </property>
              </object>
            </property>

          </object>
        </property>
      </object>
    </property>
  </template>
</interface>
