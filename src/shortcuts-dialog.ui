<interface domain="vrxx">
  <!--
    ============================================================================
    ДИАЛОГ ГОРЯЧИХ КЛАВИШ ПРИЛОЖЕНИЯ (AdwShortcutsDialog)
    ============================================================================

    СТРУКТУРА ДИАЛОГА:
    ┌──────────────────────────────────────────────────────────────────────────┐
    │ AdwShortcutsDialog (shortcuts_dialog):                                   │
    │ └─ AdwShortcutsSection ("Shortcuts" / "Сочетания клавиш"):               │
    │    ├─ [Показать сочетания клавиш] -> app.shortcuts                       │
    │    └─ [Завершить работу (Quit)]   -> app.quit                            │
    └──────────────────────────────────────────────────────────────────────────┘
  -->

  <object class="AdwShortcutsDialog" id="shortcuts_dialog">
    <child>
      <!-- Секция основных горячих клавиш -->
      <object class="AdwShortcutsSection">
        <property name="title" translatable="yes">Shortcuts</property>

        <!-- Показать диалог сочетаний клавиш (Ctrl+?) -->
        <child>
          <object class="AdwShortcutsItem">
            <property name="title" translatable="yes" context="shortcut window">Show Shortcuts</property>
            <property name="action-name">app.shortcuts</property>
          </object>
        </child>

        <!-- Закрыть программу (Ctrl+Q) -->
        <child>
          <object class="AdwShortcutsItem">
            <property name="title" translatable="yes" context="shortcut window">Quit</property>
            <property name="action-name">app.quit</property>
          </object>
        </child>

      </object>
    </child>
  </object>
</interface>
