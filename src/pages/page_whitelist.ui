<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <requires lib="gtk" version="4.0"/>
  <requires lib="Adw" version="1.0"/>

  <template class="VrxxPageWhitelist" parent="AdwBin">
    <property name="child">
      <object class="AdwToolbarView">
        <child type="top">
          <object class="AdwHeaderBar">
            <property name="title-widget">
              <object class="AdwWindowTitle">
                <property name="title" translatable="yes">Белый список</property>
              </object>
            </property>
          </object>
        </child>

        <property name="content">
          <object class="AdwStatusPage">
            <property name="icon-name">funnel-symbolic</property>
            <property name="title" translatable="yes">Домены и IP</property>
            <property name="description" translatable="yes">Правила маршрутизации (В разработке)</property>
          </object>
        </property>
      </object>
    </property>
  </template>
</interface>
