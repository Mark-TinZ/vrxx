<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <template class="VrxxWhitelistPage" parent="AdwBin">
    <property name="child">
      <object class="AdwToolbarView">

        <!-- TITLE BAR -->
        <child type="top">
          <object class="AdwHeaderBar">
            <property name="title-widget">
                <object class="AdwWindowTitle">
                    <property name="title" translatable="yes">Routing</property>
                </object>
            </property>
            <child type="end">
              <object class="GtkMenuButton" id="primary_menu_btn">
                <property name="icon-name">open-menu-symbolic</property>
                <property name="primary">True</property>
              </object>
            </child>
          </object>
        </child>

        <!-- CONTENT -->
        <property name="content">
          <object class="AdwPreferencesPage">
          
            <child>
              <object class="AdwPreferencesGroup">
                <child>
                  <object class="AdwSwitchRow" id="enable_routing_row">
                    <property name="title" translatable="yes">Enable custom routing</property>
                    <property name="subtitle" translatable="yes">Use rules below to route traffic</property>
                  </object>
                </child>
              </object>
            </child>

            <!-- Группа: режим -->
            <child>
              <object class="AdwPreferencesGroup" id="routing_settings_group">
                <property name="sensitive" bind-source="enable_routing_row" bind-property="active" bind-flags="sync-create"/>
                <child>
                  <object class="AdwComboRow" id="mode_row">
                    <property name="title" translatable="yes">Mode</property>
                    <property name="model">
                      <object class="GtkStringList">
                        <items>
                          <item translatable="yes">Exceptions (bypass VPN)</item>
                          <item translatable="yes">Inclusions (VPN only)</item>
                        </items>
                      </object>
                    </property>
                    <property name="selected">0</property>
                  </object>
                </child>
              </object>
            </child>

            <!-- Region Rules -->
            <child>
              <object class="AdwPreferencesGroup" id="routing_regions_group">
                <property name="title" translatable="yes">Geosite Rules</property>
                <property name="sensitive" bind-source="enable_routing_row" bind-property="active" bind-flags="sync-create"/>
                <child>
                  <object class="AdwSwitchRow" id="route_ru_row">
                    <property name="title" translatable="yes">Route Russia (RU)</property>
                    <property name="subtitle" translatable="yes">Apply rule for Russian domains and IPs</property>
                  </object>
                </child>
                <child>
                  <object class="AdwSwitchRow" id="route_cn_row">
                    <property name="title" translatable="yes">Route China (CN)</property>
                    <property name="subtitle" translatable="yes">Apply rule for Chinese domains and IPs</property>
                  </object>
                </child>
                <child>
                  <object class="AdwSwitchRow" id="route_ir_row">
                    <property name="title" translatable="yes">Route Iran (IR)</property>
                    <property name="subtitle" translatable="yes">Apply rule for Iranian domains and IPs</property>
                  </object>
                </child>
                <child>
                  <object class="AdwSwitchRow" id="route_antifilter_row">
                    <property name="title" translatable="yes">Route Antifilter</property>
                    <property name="subtitle" translatable="yes">Apply rule for blocked domains (Antifilter)</property>
                  </object>
                </child>
              </object>
            </child>

            <child>
              <object class="AdwPreferencesGroup">
                <property name="title" translatable="yes">Network Settings</property>
                <child>
                  <object class="AdwSwitchRow" id="disable_ipv6_row">
                    <property name="title" translatable="yes">Disable IPv6</property>
                    <property name="subtitle" translatable="yes">Force VPN core to use IPv4 only</property>
                  </object>
                </child>
              </object>
            </child>

          </object>
        </property>

      </object>
    </property>
  </template>
</interface>