<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <template class="VrxxVpnPage" parent="AdwBin">
    <property name="child">
      <object class="AdwToolbarView">

        <!-- TITLE BAR -->
        <child type="top">
          <object class="AdwHeaderBar">
            <!-- Заголовок -->
            <property name="title-widget">
            <object class="AdwWindowTitle" id="window_title">
              <property name="title" translatable="yes">VPN Keys</property>
              <property name="subtitle" translatable="yes">Mark-Vless Connected</property>
            </object>
            </property>

            <!-- Кнопки импорта ключей -->
            <child type="start">
              <object class="GtkBox">
                <property name="spacing">6</property>
                
                <child>
                  <object class="GtkButton" id="btn_import_link">
                    <property name="icon-name">list-add-symbolic</property>
                    <property name="tooltip-text" translatable="yes">Import from link</property>
                    <property name="action-name">vpn.add_key</property>
                  </object>
                </child>

                <child>
                  <object class="GtkButton" id="btn_import_clipboard">
                    <property name="icon-name">edit-paste-symbolic</property>
                    <property name="tooltip-text" translatable="yes">Import from clipboard</property>
                    <property name="action-name">vpn.import_clipboard</property>
                  </object>
                </child>

              </object>
            </child>

            <child type="end">
              <object class="GtkMenuButton" id="primary_menu_btn">
                <property name="icon-name">open-menu-symbolic</property>
                <property name="primary">True</property>
              </object>
            </child>

            <child type="end">
              <object class="GtkButton">
                <property name="label" translatable="yes">Disconnect</property>
                <property name="action-name">vpn.disconnect</property>
                <style>
                  <class name="destructive-action"/>
                </style>
              </object>
            </child>
          </object>
        </child>

        <!-- CONTENT -->
        <property name="content">
        <object class="AdwPreferencesPage">
          <child>
            <!-- ОДНА ГРУППА ДЛЯ ВСЕХ КЛЮЧЕЙ -->
            <object class="AdwPreferencesGroup">
              <property name="title" translatable="yes">Connection list</property>
              <child>
                <!-- ОДИН СПИСOK С ID -->
                <object class="GtkListBox" id="keys_list">
                  <property name="selection-mode">none</property>
                  <property name="show-separators">True</property> <!-- Разделители между ключами -->
                  <style>
                    <class name="boxed-list"/>
                  </style>
                  <!-- Внутренности (строки) будут созданы Rust-кодом -->
                </object>
              </child>
            </object>
          </child>

        </object>
      </property>

      </object>
    </property>
  </template>
</interface>

