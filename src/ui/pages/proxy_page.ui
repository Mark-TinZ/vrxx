<interface domain="vrxx">
  <!--
    ============================================================================
    СТРАНИЦА НАСТРОЕК СИСТЕМНОГО ПРОКСИ (VrxxProxyPage)
    ============================================================================

    СТРУКТУРА МАКЕТА:
    ┌──────────────────────────────────────────────────────────────────────────┐
    │ AdwHeaderBar (Шапка):                                                    │
    │ ├─ [Кнопка Сохранить: btn_apply] (Применить и перезапустить ядро)        │
    │ ├─ AdwWindowTitle: "Proxy" / "Прокси"                                    │
    │ └─ [Кнопка Меню: primary_menu_btn]                                       │
    ├──────────────────────────────────────────────────────────────────────────┤
    │ AdwPreferencesPage (Секции параметров):                                  │
    │ ├─ 1. System proxy (Системный прокси): Авто-настройка GNOME GSettings    │
    │ └─ 2. Inbound connections (Входящие порты ядра sing-box):                │
    │       ├─ SOCKS5 Port (socks_port_row, по умолчанию 10808)                │
    │       ├─ HTTP Port   (http_port_row, по умолчанию 10809)                 │
    │       └─ Allow LAN   (allow_lan_switch: доступ из локальной сети)        │
    └──────────────────────────────────────────────────────────────────────────┘
  -->

  <template class="VrxxProxyPage" parent="AdwBin">
    <property name="child">
      <object class="AdwToolbarView">

        <!-- ================================================================= -->
        <!-- 1. ВЕРХНЯЯ ПАНЕЛЬ ИНСТРУМЕНТОВ (HEADERBAR & ACTIONS)              -->
        <!-- ================================================================= -->
        <child type="top">
          <object class="AdwHeaderBar">
            <property name="title-widget">
              <object class="AdwWindowTitle">
                <property name="title" translatable="yes">Proxy</property>
              </object>
            </property>

            <!-- Кнопка применения настроек прокси -->
            <child type="start">
              <object class="GtkButton" id="btn_apply">
                <property name="visible">False</property>
                <property name="icon-name">document-save-symbolic</property>
                <property name="tooltip-text" translatable="yes">Apply and Restart Core</property>
                <style>
                  <class name="suggested-action"/>
                </style>
              </object>
            </child>

            <!-- Главное контекстное меню -->
            <child type="end">
              <object class="GtkMenuButton" id="primary_menu_btn">
                <property name="icon-name">open-menu-symbolic</property>
                <property name="primary">True</property>
              </object>
            </child>
          </object>
        </child>

        <!-- ================================================================= -->
        <!-- 2. СЕКЦИИ ПАРАМЕТРОВ ПРОКСИ (PREFERENCES PAGE)                    -->
        <!-- ================================================================= -->
        <property name="content">
          <object class="AdwPreferencesPage">

            <!-- ============================================================= -->
            <!-- СЕКЦИЯ 1: СИСТЕМНЫЙ ПРОКСИ GNOME                              -->
            <!-- ============================================================= -->
            <child>
              <object class="AdwPreferencesGroup">
                <property name="title" translatable="yes">System proxy</property>
                <property name="description" translatable="yes">Automatic proxy configuration for the whole system (GNOME)</property>

                <!-- Автоматическая установка системного прокси GNOME при подключении -->
                <child>
                  <object class="AdwSwitchRow" id="system_proxy_switch">
                    <property name="title" translatable="yes">Set system proxy</property>
                    <property name="subtitle" translatable="yes">When connected, application traffic will go through the proxy</property>
                  </object>
                </child>
              </object>
            </child>

            <!-- ============================================================= -->
            <!-- СЕКЦИЯ 2: ВХОДЯЩИЕ ЛОКАЛЬНЫЕ ПОРТЫ (INBOUNDS)                 -->
            <!-- ============================================================= -->
            <child>
              <object class="AdwPreferencesGroup">
                <property name="title" translatable="yes">Inbound connections (Inbounds)</property>
                <property name="description" translatable="yes">Local ports where the core proxy servers run</property>

                <!-- Локальный порт для SOCKS5 прокси -->
                <child>
                  <object class="AdwSpinRow" id="socks_port_row">
                    <property name="title" translatable="yes">SOCKS5 Port</property>
                    <property name="adjustment">
                      <object class="GtkAdjustment">
                        <property name="lower">1024</property>
                        <property name="upper">65535</property>
                        <property name="step-increment">1</property>
                        <property name="value">10808</property>
                      </object>
                    </property>
                  </object>
                </child>

                <!-- Локальный порт для HTTP прокси -->
                <child>
                  <object class="AdwSpinRow" id="http_port_row">
                    <property name="title" translatable="yes">HTTP Port</property>
                    <property name="adjustment">
                      <object class="GtkAdjustment">
                        <property name="lower">1024</property>
                        <property name="upper">65535</property>
                        <property name="step-increment">1</property>
                        <property name="value">10809</property>
                      </object>
                    </property>
                  </object>
                </child>

                <!-- Разрешить подключения к локальному прокси из локальной сети (LAN) -->
                <child>
                  <object class="AdwSwitchRow" id="allow_lan_switch">
                    <property name="title" translatable="yes">Allow connections from LAN</property>
                    <property name="subtitle" translatable="yes">Proxy will be available for other devices in your local network</property>
                  </object>
                </child>

              </object>
            </child>

          </object>
        </property>

      </object>
    </property>
  </template>
</interface>
