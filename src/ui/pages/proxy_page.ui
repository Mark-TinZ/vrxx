<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <template class="VrxxProxyPage" parent="AdwBin">
    <property name="child">
      <object class="AdwToolbarView">

        <!-- TITLE BAR -->
        <child type="top">
          <object class="AdwHeaderBar">
            <property name="title-widget">
                <object class="AdwWindowTitle">
                    <property name="title" translatable="yes">Локальный прокси</property>
                </object>
            </property>
             <child type="end">
              <object class="GtkMenuButton" id="primary_menu_btn">
                <property name="icon-name">open-menu-symbolic</property>
                <property name="primary">True</property>
              </object>
            </child>
          </object>
        </child>

        <!-- CONTENT -->
        <property name="content">
          <object class="AdwPreferencesPage">

            <!-- Группа: Системный прокси -->
            <child>
              <object class="AdwPreferencesGroup">
                <property name="title" translatable="yes">Системный прокси</property>
                <property name="description" translatable="yes">Автоматическая настройка прокси для всей системы (GNOME)</property>
                <child>
                  <object class="AdwSwitchRow" id="system_proxy_switch">
                    <property name="title" translatable="yes">Устанавливать системный прокси</property>
                    <property name="subtitle" translatable="yes">При активном подключении трафик приложений пойдет через прокси</property>
                  </object>
                </child>
              </object>
            </child>

            <!-- Группа: Входящие порты -->
            <child>
              <object class="AdwPreferencesGroup">
                <property name="title" translatable="yes">Входящие подключения (Inbounds)</property>
                <property name="description" translatable="yes">Локальные порты, на которых работают прокси-серверы ядра</property>

                <child>
                  <object class="AdwSpinRow" id="socks_port_row">
                    <property name="title" translatable="yes">SOCKS5 Порт</property>
                    <property name="adjustment">
                      <object class="GtkAdjustment">
                        <property name="lower">1024</property>
                        <property name="upper">65535</property>
                        <property name="step-increment">1</property>
                        <property name="value">10808</property>
                      </object>
                    </property>
                  </object>
                </child>

                <child>
                  <object class="AdwSpinRow" id="http_port_row">
                    <property name="title" translatable="yes">HTTP Порт</property>
                    <property name="adjustment">
                      <object class="GtkAdjustment">
                        <property name="lower">1024</property>
                        <property name="upper">65535</property>
                        <property name="step-increment">1</property>
                        <property name="value">10809</property>
                      </object>
                    </property>
                  </object>
                </child>

                <child>
                  <object class="AdwSwitchRow" id="allow_lan_switch">
                    <property name="title" translatable="yes">Разрешить подключения из LAN</property>
                    <property name="subtitle" translatable="yes">Прокси будет доступен для других устройств в вашей локальной сети</property>
                  </object>
                </child>

              </object>
            </child>

          </object>
        </property>

      </object>
    </property>
  </template>
</interface>
