<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <template class="VrxxSettingsPage" parent="AdwBin">
    <property name="child">
      <object class="AdwToolbarView">

        <!-- TITLE BAR -->
        <child type="top">
          <object class="AdwHeaderBar">
            <property name="title-widget">
                <object class="AdwWindowTitle">
                    <property name="title" translatable="yes">Настройки</property>
                </object>
            </property>
             <child type="end">
              <object class="GtkMenuButton" id="primary_menu_btn">
                <property name="icon-name">open-menu-symbolic</property>
                <property name="primary">True</property>
                <property name="tooltip-text" translatable="yes">Меню</property>
              </object>
            </child>
          </object>
        </child>

        <!-- CONTENT -->
        <property name="content">
          <object class="AdwPreferencesPage">

            <!-- General Settings -->
            <child>
              <object class="AdwPreferencesGroup">
                <property name="title" translatable="yes">Общие</property>

                <child>
                  <object class="AdwComboRow" id="language_row">
                    <property name="title" translatable="yes">Язык (Language)</property>
                    <property name="subtitle" translatable="yes">Требуется перезапуск приложения (Requires restart)</property>
                    <property name="model">
                      <object class="GtkStringList">
                        <items>
                          <item translatable="yes">Системный (System)</item>
                          <item translatable="yes">English</item>
                          <item translatable="yes">Русский</item>
                        </items>
                      </object>
                    </property>
                  </object>
                </child>

                <child>
                  <object class="AdwSwitchRow" id="autostart_row">
                    <property name="title" translatable="yes">Запускать при старте системы</property>
                    <property name="subtitle" translatable="yes">Автоматически запускать приложение в фоновом режиме</property>
                    <property name="active">True</property>
                  </object>
                </child>

                <child>
                  <object class="AdwSwitchRow" id="connect_startup_row">
                    <property name="title" translatable="yes">Подключаться при запуске</property>
                    <property name="subtitle" translatable="yes">Восстанавливать последнее активное подключение</property>
                    <property name="active">False</property>
                  </object>
                </child>

                <child>
                  <object class="AdwSwitchRow" id="notifications_row">
                    <property name="title" translatable="yes">Уведомления</property>
                    <property name="subtitle" translatable="yes">Показывать уведомления при смене статуса подключения</property>
                    <property name="active">True</property>
                  </object>
                </child>

                <child>
                  <object class="AdwSwitchRow" id="streamer_mode_row">
                    <property name="title" translatable="yes">Режим стримера</property>
                    <property name="subtitle" translatable="yes">Скрывать IP-адреса и конфиденциальную информацию в интерфейсе</property>
                    <property name="active">False</property>
                  </object>
                </child>
              </object>
            </child>

            <!-- Core Settings -->
            <child>
              <object class="AdwPreferencesGroup">
                <property name="title" translatable="yes">Ядро (Core)</property>
                <property name="description" translatable="yes">Выберите движок маршрутизации, используемый для подключения</property>

                <child>
                  <object class="AdwComboRow" id="core_selector">
                    <property name="title" translatable="yes">Используемое ядро</property>
                    <property name="subtitle" translatable="yes">Xray-core или Sing-box</property>
                    <property name="sensitive">True</property>
                    <property name="model">
                      <object class="GtkStringList">
                        <items>
                          <item translatable="yes">Xray-core</item>
                          <item translatable="yes">Sing-box</item>
                        </items>
                      </object>
                    </property>
                  </object>
                </child>

                <child>
                  <object class="AdwActionRow" id="core_info_row">
                    <property name="title" translatable="yes">Версия ядра</property>
                    <property name="subtitle" translatable="yes">Неизвестно</property>
                  </object>
                </child>

                <!-- Расширенные настройки TUN спрятаны в ExpanderRow -->
                <child>
                  <object class="AdwExpanderRow" id="tun_mode_row">
                    <property name="title" translatable="yes">Настройки TUN</property>
                    <property name="subtitle" translatable="yes">Перенаправлять весь системный трафик через виртуальный интерфейс (Требуется Root)</property>
                    <property name="show-enable-switch">True</property>
                    <property name="enable-expansion">False</property> <!-- Раскрывается только если свитч включен -->
                  </object>
                </child>
              </object>
            </child>

            <!-- Network & Routing Settings -->
            <child>
              <object class="AdwPreferencesGroup">
                <property name="title" translatable="yes">Сеть и Маршрутизация</property>
                
                <child>
                  <object class="AdwSwitchRow" id="sniffing_row">
                    <property name="title" translatable="yes">Sniffing (Анализ пакетов)</property>
                    <property name="subtitle" translatable="yes">Определять домен из трафика (требуется для маршрутизации)</property>
                  </object>
                </child>

                <child>
                  <object class="AdwComboRow" id="domain_strategy_row">
                    <property name="title" translatable="yes">Стратегия доменов (Domain Strategy)</property>
                    <property name="model">
                      <object class="GtkStringList">
                        <items>
                          <item translatable="yes">AsIs (Как есть)</item>
                          <item translatable="yes">IPIfNonMatch</item>
                          <item translatable="yes">IPOnDemand</item>
                        </items>
                      </object>
                    </property>
                  </object>
                </child>

                <child>
                  <object class="AdwSwitchRow" id="bypass_lan_row">
                    <property name="title" translatable="yes">Обход LAN (Bypass LAN)</property>
                    <property name="subtitle" translatable="yes">Не маршрутизировать локальный трафик через VPN</property>
                  </object>
                </child>

                <child>
                  <object class="AdwSwitchRow" id="fake_dns_row">
                    <property name="title" translatable="yes">Fake DNS</property>
                    <property name="subtitle" translatable="yes">Возвращать поддельные IP (улучшает скорость, но ломает некоторые приложения)</property>
                  </object>
                </child>

                <child>
                  <object class="AdwExpanderRow" id="mux_row">
                    <property name="title" translatable="yes">Мультиплексирование (Mux)</property>
                    <property name="subtitle" translatable="yes">Ускоряет соединения, но может вызвать нестабильность</property>
                    <property name="show-enable-switch">True</property>
                    <child>
                        <object class="AdwSpinRow" id="mux_concurrency_row">
                            <property name="title">Concurrency</property>
                            <property name="adjustment">
                                <object class="GtkAdjustment">
                                    <property name="lower">-1</property>
                                    <property name="upper">1024</property>
                                    <property name="value">8</property>
                                    <property name="step-increment">1</property>
                                </object>
                            </property>
                        </object>
                    </child>
                  </object>
                </child>

                <child>
                  <object class="AdwSwitchRow" id="fragment_row">
                    <property name="title" translatable="yes">Фрагментация (Fragment)</property>
                    <property name="subtitle" translatable="yes">Разделять пакеты для обхода DPI (Только для TCP/TLS)</property>
                  </object>
                </child>

              </object>
            </child>

            <!-- Backup Settings -->
            <child>
              <object class="AdwPreferencesGroup">
                <property name="title" translatable="yes">Резервное копирование</property>
                <child>
                  <object class="AdwActionRow">
                    <property name="title" translatable="yes">Импорт настроек</property>
                    <property name="subtitle" translatable="yes">Загрузить профили и настройки из файла</property>
                    <property name="activatable">True</property>
                    <property name="action-name">app.import_config</property>
                    <child>
                      <object class="GtkImage">
                        <property name="icon-name">document-open-symbolic</property>
                        <property name="valign">center</property>
                      </object>
                    </child>
                  </object>
                </child>
                <child>
                  <object class="AdwActionRow">
                    <property name="title" translatable="yes">Экспорт настроек</property>
                    <property name="subtitle" translatable="yes">Сохранить текущую конфигурацию в файл</property>
                    <property name="activatable">True</property>
                    <property name="action-name">app.export_config</property>
                    <child>
                      <object class="GtkImage">
                        <property name="icon-name">document-save-symbolic</property>
                        <property name="valign">center</property>
                      </object>
                    </child>
                  </object>
                </child>
              </object>
            </child>

            <!-- Logging Settings -->
            <child>
              <object class="AdwPreferencesGroup">
                <property name="title" translatable="yes">Диагностика</property>

                <child>
                  <object class="AdwComboRow" id="log_level_row">
                    <property name="title" translatable="yes">Уровень логирования</property>
                    <property name="model">
                      <object class="GtkStringList">
                        <items>
                          <item translatable="yes">Error</item>
                          <item translatable="yes">Warning</item>
                          <item translatable="yes">Info</item>
                          <item translatable="yes">Debug</item>
                        </items>
                      </object>
                    </property>
                    <property name="selected">2</property> <!-- Info -->
                  </object>
                </child>

                 <child>
                  <object class="AdwActionRow">
                    <property name="title" translatable="yes">Просмотр логов</property>
                    <property name="subtitle" translatable="yes">Открыть консоль с логами в реальном времени</property>
                    <property name="activatable">True</property>
                    <property name="action-name">app.view_logs</property>
                    <child>
                        <object class="GtkImage">
                            <property name="icon-name">utilities-terminal-symbolic</property>
                            <property name="valign">center</property>
                        </object>
                    </child>
                  </object>
                </child>

                 <child>
                  <object class="AdwActionRow">
                    <property name="title" translatable="yes">Открыть папку логов</property>
                    <property name="subtitle" translatable="yes">Открыть системную папку с файлами журналов</property>
                    <property name="activatable">True</property>
                    <property name="action-name">app.open_log_dir</property>
                    <child>
                        <object class="GtkImage">
                            <property name="icon-name">folder-open-symbolic</property>
                            <property name="valign">center</property>
                        </object>
                    </child>
                  </object>
                </child>
              </object>
            </child>

            <child>
              <object class="AdwPreferencesGroup">
                <child>
                  <object class="AdwActionRow">
                    <property name="title" translatable="yes">Сбросить настройки</property>
                    <property name="subtitle" translatable="yes">Удалить все сохраненные данные (опасная зона)</property>
                    <property name="activatable">True</property>
                    <property name="action-name">app.reset_settings</property>
                    <style>
                        <class name="error"/>
                    </style>
                    <child>
                      <object class="GtkImage">
                        <property name="icon-name">edit-clear-all-symbolic</property>
                        <property name="valign">center</property>
                      </object>
                    </child>
                  </object>
                </child>
              </object>
            </child>

          </object>
        </property>

      </object>
    </property>
  </template>
</interface>

