<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <template class="VrxxSettingsPage" parent="AdwBin">
    <property name="child">
      <object class="AdwToolbarView">

        <!-- TITLE BAR -->
        <child type="top">
          <object class="AdwHeaderBar">
            <property name="title-widget">
                <object class="AdwWindowTitle">
                    <property name="title" translatable="yes">Settings</property>
                </object>
            </property>
             <child type="start">
              <object class="GtkButton" id="btn_apply">
                <property name="icon-name">document-save-symbolic</property>
                <property name="tooltip-text" translatable="yes">Apply and Restart Core</property>
                <style>
                  <class name="suggested-action"/>
                </style>
              </object>
            </child>
             <child type="end">
              <object class="GtkMenuButton" id="primary_menu_btn">
                <property name="icon-name">open-menu-symbolic</property>
                <property name="primary">True</property>
                <property name="tooltip-text" translatable="yes">Menu</property>
              </object>
            </child>
          </object>
        </child>

        <!-- CONTENT -->
        <property name="content">
          <object class="AdwPreferencesPage">

            <!-- General Settings -->
            <child>
              <object class="AdwPreferencesGroup">
                <property name="title" translatable="yes">General</property>

                <child>
                  <object class="AdwComboRow" id="language_row">
                    <property name="title" translatable="yes">Language</property>
                    <property name="subtitle" translatable="yes">Application restart required</property>
                    <property name="model">
                      <object class="GtkStringList">
                        <items>
                          <item translatable="yes">System default</item>
                          <item translatable="yes">English</item>
                          <item translatable="yes">Russian</item>
                        </items>
                      </object>
                    </property>
                  </object>
                </child>

                <child>
                  <object class="AdwSwitchRow" id="autostart_row">
                    <property name="title" translatable="yes">Run at startup</property>
                    <property name="subtitle" translatable="yes">Automatically start application in the background</property>
                    <property name="active">True</property>
                  </object>
                </child>

                <child>
                  <object class="AdwSwitchRow" id="connect_startup_row">
                    <property name="title" translatable="yes">Connect on startup</property>
                    <property name="subtitle" translatable="yes">Restore last active connection</property>
                    <property name="active">False</property>
                  </object>
                </child>

                <child>
                  <object class="AdwSwitchRow" id="notifications_row">
                    <property name="title" translatable="yes">Notifications</property>
                    <property name="subtitle" translatable="yes">Show notifications on connection status change</property>
                    <property name="active">True</property>
                  </object>
                </child>

                <child>
                  <object class="AdwSwitchRow" id="streamer_mode_row">
                    <property name="title" translatable="yes">Streamer mode</property>
                    <property name="subtitle" translatable="yes">Hide IP addresses and sensitive information in the interface</property>
                    <property name="active">False</property>
                  </object>
                </child>
              </object>
            </child>

            <!-- Core Settings -->
            <child>
              <object class="AdwPreferencesGroup">
                <property name="title" translatable="yes">Core</property>
                <property name="description" translatable="yes">Select the routing engine used for connection</property>

                <child>
                  <object class="AdwActionRow" id="core_info_row">
                    <property name="title" translatable="yes">Core version</property>
                    <property name="subtitle" translatable="yes">Unknown</property>
                  </object>
                </child>

                <!-- Расширенные настройки TUN перенесены на Proxy Page -->
              </object>
            </child>

            <!-- Network & Routing Settings -->
            <child>
              <object class="AdwPreferencesGroup">
                <property name="title" translatable="yes">Network and Routing</property>
                
                <child>
                  <object class="AdwSwitchRow" id="tun_mode_row">
                    <property name="title" translatable="yes">Enable TUN Mode</property>
                    <property name="subtitle" translatable="yes">Requires root privileges</property>
                    <property name="tooltip-text" translatable="yes">Creates a virtual network interface to route all system traffic transparently, bypassing application-specific proxy settings.</property>
                  </object>
                </child>

                <child>
                  <object class="AdwSwitchRow" id="sniffing_row">
                    <property name="title" translatable="yes">Sniffing (Packet analysis)</property>
                    <property name="subtitle" translatable="yes">Determine domain from traffic (required for routing)</property>
                  </object>
                </child>

                <child>
                  <object class="AdwComboRow" id="domain_strategy_row">
                    <property name="title" translatable="yes">Domain Strategy</property>
                    <property name="model">
                      <object class="GtkStringList">
                        <items>
                          <item translatable="yes">AsIs</item>
                          <item translatable="yes">IPIfNonMatch</item>
                          <item translatable="yes">IPOnDemand</item>
                        </items>
                      </object>
                    </property>
                  </object>
                </child>

                <child>
                  <object class="AdwActionRow" id="update_geo_row">
                    <property name="title" translatable="yes">Update Geo Data</property>
                    <property name="subtitle" translatable="yes">Download latest geoip and geosite data</property>
                    <child>
                      <object class="GtkStack" id="geo_update_stack">
                        <property name="transition-type">crossfade</property>
                        <child>
                          <object class="GtkStackPage">
                            <property name="name">button_page</property>
                            <property name="child">
                              <object class="GtkButton" id="btn_update_geo">
                                <property name="label" translatable="yes">Update</property>
                                <property name="valign">center</property>
                              </object>
                            </property>
                          </object>
                        </child>
                        <child>
                          <object class="GtkStackPage">
                            <property name="name">spinner_page</property>
                            <property name="child">
                              <object class="GtkSpinner" id="geo_update_spinner">
                                <property name="spinning">True</property>
                                <property name="valign">center</property>
                                <property name="margin-end">8</property>
                              </object>
                            </property>
                          </object>
                        </child>
                      </object>
                    </child>
                  </object>
                </child>

                <child>
                  <object class="AdwSwitchRow" id="bypass_lan_row">
                    <property name="title" translatable="yes">Bypass LAN</property>
                    <property name="subtitle" translatable="yes">Do not route local traffic through VPN</property>
                  </object>
                </child>

                <child>
                  <object class="AdwSwitchRow" id="fake_dns_row">
                    <property name="title" translatable="yes">Fake DNS</property>
                    <property name="subtitle" translatable="yes">Return fake IPs (improves speed but breaks some apps)</property>
                    <property name="tooltip-text" translatable="yes">Returns fake local IP addresses for DNS requests, then resolves the real IP remotely. Speeds up browsing but may break apps requiring real IPs.</property>
                  </object>
                </child>

                <child>
                  <object class="AdwExpanderRow" id="advanced_network_expander">
                    <property name="title" translatable="yes">Advanced Settings</property>
                    
                    <child>
                      <object class="AdwExpanderRow" id="mux_row">
                        <property name="title" translatable="yes">Multiplexing (Mux)</property>
                        <property name="subtitle" translatable="yes">Speeds up connections but may cause instability</property>
                        <property name="tooltip-text" translatable="yes">Reduces handshake latency by reusing a single TCP connection for multiple requests.</property>
                        <property name="show-enable-switch">True</property>
                        <child>
                            <object class="AdwSpinRow" id="mux_concurrency_row">
                                <property name="title">Concurrency</property>
                                <property name="adjustment">
                                    <object class="GtkAdjustment">
                                        <property name="lower">-1</property>
                                        <property name="upper">1024</property>
                                        <property name="value">8</property>
                                        <property name="step-increment">1</property>
                                    </object>
                                </property>
                            </object>
                        </child>
                      </object>
                    </child>

                    <child>
                      <object class="AdwSwitchRow" id="fragment_row">
                        <property name="title" translatable="yes">Fragmentation (Fragment)</property>
                        <property name="subtitle" translatable="yes">Split packets to bypass DPI (TCP/TLS only)</property>
                      </object>
                    </child>
                  </object>
                </child>

              </object>
            </child>

            <!-- Backup Settings -->
            <child>
              <object class="AdwPreferencesGroup">
                <property name="title" translatable="yes">Backup</property>
                <child>
                  <object class="AdwActionRow">
                    <property name="title" translatable="yes">Import settings</property>
                    <property name="subtitle" translatable="yes">Load profiles and settings from file</property>
                    <property name="activatable">True</property>
                    <property name="action-name">app.import_config</property>
                    <child>
                      <object class="GtkImage">
                        <property name="icon-name">document-open-symbolic</property>
                        <property name="valign">center</property>
                      </object>
                    </child>
                  </object>
                </child>
                <child>
                  <object class="AdwActionRow">
                    <property name="title" translatable="yes">Export settings</property>
                    <property name="subtitle" translatable="yes">Save current configuration to file</property>
                    <property name="activatable">True</property>
                    <property name="action-name">app.export_config</property>
                    <child>
                      <object class="GtkImage">
                        <property name="icon-name">document-save-symbolic</property>
                        <property name="valign">center</property>
                      </object>
                    </child>
                  </object>
                </child>
              </object>
            </child>

            <!-- Latency / Ping Settings -->
            <child>
              <object class="AdwPreferencesGroup">
                <property name="title" translatable="yes">Latency Testing</property>

                <child>
                  <object class="AdwComboRow" id="ping_algorithm_row">
                    <property name="title" translatable="yes">Ping Algorithm</property>
                    <property name="subtitle" translatable="yes">Method used for measuring server latency</property>
                    <property name="model">
                      <object class="GtkStringList">
                        <items>
                          <item translatable="yes">TCP Handshake</item>
                          <item translatable="yes">ICMP Ping</item>
                          <item translatable="yes">HTTP GET (via Proxy)</item>
                          <item translatable="yes">HTTP HEAD (via Proxy)</item>
                        </items>
                      </object>
                    </property>
                    <property name="selected">0</property>
                  </object>
                </child>

                <child>
                  <object class="AdwEntryRow" id="ping_target_url_row">
                    <property name="title" translatable="yes">Ping Target URL</property>
                    <property name="text">https://www.gstatic.com/generate_204</property>
                  </object>
                </child>
              </object>
            </child>

            <!-- Logging Settings -->
            <child>
              <object class="AdwPreferencesGroup">
                <property name="title" translatable="yes">Diagnostics</property>

                <child>
                  <object class="AdwComboRow" id="log_level_row">
                    <property name="title" translatable="yes">Logging level</property>
                    <property name="model">
                      <object class="GtkStringList">
                        <items>
                          <item translatable="yes">Error</item>
                          <item translatable="yes">Warning</item>
                          <item translatable="yes">Info</item>
                          <item translatable="yes">Debug</item>
                        </items>
                      </object>
                    </property>
                    <property name="selected">2</property> <!-- Info -->
                  </object>
                </child>

                 <child>
                  <object class="AdwActionRow">
                    <property name="title" translatable="yes">View logs</property>
                    <property name="subtitle" translatable="yes">Open console with real-time logs</property>
                    <property name="activatable">True</property>
                    <property name="action-name">app.view_logs</property>
                    <child>
                        <object class="GtkImage">
                            <property name="icon-name">utilities-terminal-symbolic</property>
                            <property name="valign">center</property>
                        </object>
                    </child>
                  </object>
                </child>

                 <child>
                  <object class="AdwActionRow">
                    <property name="title" translatable="yes">Open logs folder</property>
                    <property name="subtitle" translatable="yes">Open system folder with log files</property>
                    <property name="activatable">True</property>
                    <property name="action-name">app.open_log_dir</property>
                    <child>
                        <object class="GtkImage">
                            <property name="icon-name">folder-open-symbolic</property>
                            <property name="valign">center</property>
                        </object>
                    </child>
                  </object>
                </child>
              </object>
            </child>

            <child>
              <object class="AdwPreferencesGroup">
                <child>
                  <object class="AdwActionRow">
                    <property name="title" translatable="yes">Reset settings</property>
                    <property name="subtitle" translatable="yes">Delete all saved data (danger zone)</property>
                    <property name="activatable">True</property>
                    <property name="action-name">app.reset_settings</property>
                    <style>
                        <class name="error"/>
                    </style>
                    <child>
                      <object class="GtkImage">
                        <property name="icon-name">edit-clear-all-symbolic</property>
                        <property name="valign">center</property>
                      </object>
                    </child>
                  </object>
                </child>
              </object>
            </child>

          </object>
        </property>

      </object>
    </property>
  </template>
</interface>
