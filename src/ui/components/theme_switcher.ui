<interface domain="vrxx">
  <!--
    ============================================================================
    КОМПОНЕНТ ПЕРЕКЛЮЧЕНИЯ ЦВЕТОВОЙ СХЕМЫ ТЕМЫ (VrxxThemeSwitcher)
    ============================================================================

    СТРУКТУРА МАКЕТА:
    ┌──────────────────────────────────────────────────────────────────────────┐
    │ GtkBox (Горизонтальный ряд круглых селекторов темы, класс: themeselector)│
    │ ├─ [Кнопка: btn_system] -> Системная тема (app.set-color-scheme='default')│
    │ ├─ [Кнопка: btn_light]  -> Светлая тема (app.set-color-scheme='force-light')
    │ └─ [Кнопка: btn_dark]   -> Тёмная тема (app.set-color-scheme='force-dark')│
    └──────────────────────────────────────────────────────────────────────────┘
  -->

  <template class="VrxxThemeSwitcher" parent="GtkBox">
    <property name="orientation">horizontal</property>
    <property name="halign">center</property>
    <property name="valign">center</property>
    <property name="margin-top">6</property>
    <property name="margin-bottom">6</property>
    <property name="margin-start">6</property>
    <property name="margin-end">6</property>
    <property name="spacing">12</property>
    <style>
      <class name="themeselector"/>
    </style>

    <!-- 1. Системная тема (автоматическое следование настройкам ОС) -->
    <child>
      <object class="GtkCheckButton" id="btn_system">
        <property name="tooltip-text" translatable="yes">System</property>
        <property name="action-name">app.set-color-scheme</property>
        <property name="action-target">'default'</property>
        <property name="hexpand">true</property>
        <property name="halign">center</property>
        <property name="focus-on-click">false</property>
        <style>
          <class name="theme-selector"/>
          <class name="follow"/>
        </style>
      </object>
    </child>

    <!-- 2. Принудительная светлая тема -->
    <child>
      <object class="GtkCheckButton" id="btn_light">
        <property name="tooltip-text" translatable="yes">Light</property>
        <property name="action-name">app.set-color-scheme</property>
        <property name="action-target">'force-light'</property>
        <property name="group">btn_system</property>
        <property name="hexpand">true</property>
        <property name="halign">center</property>
        <property name="focus-on-click">false</property>
        <style>
          <class name="theme-selector"/>
          <class name="light"/>
        </style>
      </object>
    </child>

    <!-- 3. Принудительная тёмная тема -->
    <child>
      <object class="GtkCheckButton" id="btn_dark">
        <property name="tooltip-text" translatable="yes">Dark</property>
        <property name="action-name">app.set-color-scheme</property>
        <property name="action-target">'force-dark'</property>
        <property name="group">btn_system</property>
        <property name="hexpand">true</property>
        <property name="halign">center</property>
        <property name="focus-on-click">false</property>
        <style>
          <class name="theme-selector"/>
          <class name="dark"/>
        </style>
      </object>
    </child>

  </template>
</interface>
