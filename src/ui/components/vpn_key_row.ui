<interface domain="vrxx">
  <!-- 
    ========================================================================
    Компонент строки списка VPN-ключей (VrxxVpnKeyRow).
    
    Содержит:
    - Заголовок строки (AdwActionRow header_row): имя профиля и протокол
    - Префикс: стек иконок состояний (icon_stack): 
        * inactive (красный щит)
        * active (зеленый щит)
        * loading (крутящийся спиннер GtkSpinner)
        * error (желтый щит предупреждения)
    - Суффикс: кнопка вызова контекстного меню (view-more-symbolic)
    - Выпадающий блок деталей (details_revealer): 
        * Статистика входящего и исходящего трафика
        * Время активности соединения
        * Географическая локация сервера
    - Контекстное меню (key_menu):
        * Информация (_Info)
        * Изменить (_Edit)
        * Поделиться (_Share) -> открывает диалоговое окно Поделиться
        * Удалить (_Delete)
    ========================================================================
  -->
  <template class="VrxxVpnKeyRow" parent="GtkListBoxRow">
    <property name="activatable">True</property>
    <property name="overflow">hidden</property>
    <style>
      <class name="vpn-key-row"/>
    </style>
    <property name="child">
      <object class="GtkBox">
        <property name="orientation">vertical</property>
        <property name="overflow">hidden</property>

        <!-- Шапка строки ключа -->
        <child>
          <object class="AdwActionRow" id="header_row">
            <property name="title-lines">1</property>
            <property name="subtitle-lines">1</property>
            <property name="activatable">True</property>
            <style>
              <class name="vpn-header-row"/>
            </style>
            <!-- Префикс: Индикатор состояния подключения (Стек иконок/спиннера) -->
            <child type="prefix">
              <object class="GtkStack" id="icon_stack">
                <property name="transition-type">crossfade</property>
                <property name="transition-duration">250</property>

                <!-- Состояние: Неактивен (Красный щит) -->
                <child>
                  <object class="GtkStackPage">
                    <property name="name">inactive</property>
                    <property name="child">
                      <object class="GtkImage">
                        <property name="icon-name">security-low-symbolic</property>
                        <style><class name="error"/></style>
                      </object>
                    </property>
                  </object>
                </child>

                <!-- Состояние: Подключен и активен (Зеленый щит) -->
                <child>
                  <object class="GtkStackPage">
                    <property name="name">active</property>
                    <property name="child">
                      <object class="GtkImage">
                        <property name="icon-name">security-high-symbolic</property>
                        <style><class name="success"/></style>
                      </object>
                    </property>
                  </object>
                </child>

                <!-- Состояние: Процесс подключения (Колесико загрузки GtkSpinner) -->
                <child>
                  <object class="GtkStackPage">
                    <property name="name">loading</property>
                    <property name="child">
                      <object class="GtkSpinner">
                        <property name="spinning">True</property>
                        <property name="halign">center</property>
                        <property name="valign">center</property>
                      </object>
                    </property>
                  </object>
                </child>

                <!-- Состояние: Ошибка подключения (Желтый щит) -->
                <child>
                  <object class="GtkStackPage">
                    <property name="name">error</property>
                    <property name="child">
                      <object class="GtkImage">
                        <property name="icon-name">security-medium-symbolic</property>
                        <style><class name="warning"/></style>
                      </object>
                    </property>
                  </object>
                </child>
              </object>
            </child>

            <!-- Суффикс: Индикатор задержки / пинга (GNOME HIG: .caption .numeric) -->
            <child type="suffix">
              <object class="GtkLabel" id="lbl_row_ping">
                <property name="can-target">False</property>
                <property name="valign">center</property>
                <property name="halign">end</property>
                <property name="visible">False</property>
                <property name="ellipsize">end</property>
                <property name="max-width-chars">10</property>
                <style>
                  <class name="caption"/>
                  <class name="numeric"/>
                  <class name="dim-label"/>
                </style>
              </object>
            </child>

            <!-- Суффикс: Кнопка открытия контекстного меню ключа -->
            <child type="suffix">
              <object class="GtkMenuButton">
                <property name="icon-name">view-more-symbolic</property>
                <property name="valign">center</property>
                <property name="menu-model">key_menu</property>
                <style><class name="flat"/></style>
              </object>
            </child>
          </object>
        </child>

        <!-- Выпадающий блок статистики и метрик активного ключа -->
        <child>
          <object class="GtkRevealer" id="details_revealer">
            <property name="transition-type">slide-down</property>
            <property name="transition-duration">300</property>
            <property name="reveal-child">False</property>

            <property name="child">
              <object class="GtkBox">
                <property name="orientation">vertical</property>

                <child>
                  <object class="GtkSeparator">
                     <style><class name="spacer"/></style>
                  </object>
                </child>

                <child>
                  <object class="GtkGrid">
                    <property name="margin-top">10</property>
                    <property name="margin-bottom">10</property>
                    <property name="margin-start">12</property>
                    <property name="margin-end">12</property>
                    <property name="column-spacing">8</property>
                    <property name="row-spacing">6</property>
                    <property name="column-homogeneous">True</property>
                    <property name="hexpand">True</property>

                    <!-- Метрика: Загрузка (Входящий трафик) -->
                    <child>
                      <object class="GtkBox">
                        <property name="spacing">6</property>
                        <child><object class="GtkImage"><property name="icon-name">go-down-symbolic</property><style><class name="dim-label"/></style></object></child>
                        <child><object class="GtkLabel" id="lbl_down"><property name="label">0 MB</property><property name="ellipsize">end</property><style><class name="dim-label"/></style></object></child>
                        <layout><property name="column">0</property><property name="row">0</property></layout>
                      </object>
                    </child>

                    <!-- Метрика: Отдача (Исходящий трафик) -->
                    <child>
                      <object class="GtkBox">
                        <property name="spacing">6</property>
                        <child><object class="GtkImage"><property name="icon-name">go-up-symbolic</property><style><class name="dim-label"/></style></object></child>
                        <child><object class="GtkLabel" id="lbl_up"><property name="label">0 MB</property><property name="ellipsize">end</property><style><class name="dim-label"/></style></object></child>
                        <layout><property name="column">0</property><property name="row">1</property></layout>
                      </object>
                    </child>

                    <!-- Метрика: Время сессии -->
                    <child>
                      <object class="GtkBox">
                        <property name="spacing">6</property>
                        <child><object class="GtkImage"><property name="icon-name">alarm-symbolic</property><style><class name="dim-label"/></style></object></child>
                        <child><object class="GtkLabel" id="lbl_time"><property name="label">00:00</property><property name="ellipsize">end</property><style><class name="dim-label"/></style></object></child>
                        <layout><property name="column">1</property><property name="row">0</property></layout>
                      </object>
                    </child>

                    <!-- Метрика: Географическая локация сервера -->
                    <child>
                      <object class="GtkBox">
                        <property name="spacing">6</property>
                        <child>
                          <object class="GtkImage">
                            <property name="icon-name">mark-location-symbolic</property>
                            <style><class name="dim-label"/></style>
                          </object>
                        </child>
                        <child>
                          <object class="GtkLabel" id="lbl_location">
                            <property name="label">Unknown</property>
                            <property name="ellipsize">end</property>
                            <property name="xalign">0</property>
                            <style><class name="dim-label"/></style>
                          </object>
                        </child>
                        <layout><property name="column">1</property><property name="row">1</property></layout>
                      </object>
                    </child>
                  </object>
                </child>
              </object>
            </property>
          </object>
        </child>

      </object>
    </property>
  </template>

  <!-- Контекстное меню строки ключа -->
  <menu id="key_menu">
    <section>
      <item>
        <attribute name="label" translatable="yes">_Info</attribute>
        <attribute name="action">row.key_info</attribute>
      </item>
      <item>
        <attribute name="label" translatable="yes">_Ping</attribute>
        <attribute name="action">row.key_ping</attribute>
      </item>
      <item>
        <attribute name="label" translatable="yes">_Edit</attribute>
        <attribute name="action">row.key_edit</attribute>
      </item>
      <!-- Вызов единого диалогового окна Поделиться (Share) -->
      <item>
        <attribute name="label" translatable="yes">_Share</attribute>
        <attribute name="action">row.key_share</attribute>
      </item>
      <item>
        <attribute name="label" translatable="yes">Move to _Group</attribute>
        <attribute name="action">row.key_move_group</attribute>
      </item>
      <item>
        <attribute name="label" translatable="yes">_Delete</attribute>
        <attribute name="action">row.delete</attribute>
      </item>
    </section>
  </menu>
</interface>
