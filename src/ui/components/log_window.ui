<interface domain="vrxx">
  <!--
    ============================================================================
    ОКНО ПРОСМОТРА СИСТЕМНЫХ ЛОГОВ (VrxxLogWindow)
    ============================================================================

    СТРУКТУРА МАКЕТА:
    ┌──────────────────────────────────────────────────────────────────────────┐
    │ AdwHeaderBar (Шапка окна):                                               │
    │ ├─ [Кнопка: Автоскролл] [Выпадающий список: Фильтр уровней логов]        │
    │ ├─ AdwWindowTitle: "System Logs" / "Системные логи"                      │
    │ └─ [Кнопка: Поиск Ctrl+F] [Кнопка Меню: Масштаб, Копировать, Сохранить] │
    ├──────────────────────────────────────────────────────────────────────────┤
    │ GtkSearchBar (Панель поиска, search_bar):                                │
    │ └─ GtkSearchEntry (search_entry: Поле фильтрации строк)                  │
    ├──────────────────────────────────────────────────────────────────────────┤
    │ GtkScrolledWindow (Контентная область, scrolled_window):                 │
    │ └─ GtkTextView (text_view: Моноширинный вывод логов в реальном времени)  │
    └──────────────────────────────────────────────────────────────────────────┘
  -->

  <!-- Контекстное меню действий с логами -->
  <menu id="log_menu">
    <!-- Слот кастомного виджета управления масштабом шрифта -->
    <section>
      <item>
        <attribute name="custom">zoom-row</attribute>
      </item>
    </section>

    <!-- Сортировка записей -->
    <section>
      <item>
        <attribute name="label" translatable="yes">Sort: Chronological</attribute>
        <attribute name="action">win.sort_chronological</attribute>
      </item>
      <item>
        <attribute name="label" translatable="yes">Sort: By Severity (Errors first)</attribute>
        <attribute name="action">win.sort_severity</attribute>
      </item>
      <item>
        <attribute name="label" translatable="yes">Sort: Newest First</attribute>
        <attribute name="action">win.sort_reverse_chronological</attribute>
      </item>
    </section>

    <!-- Операции с содержимым -->
    <section>
      <item>
        <attribute name="label" translatable="yes">Copy Logs</attribute>
        <attribute name="action">win.copy_logs</attribute>
        <attribute name="icon">edit-copy-symbolic</attribute>
      </item>
      <item>
        <attribute name="label" translatable="yes">Save Logs…</attribute>
        <attribute name="action">win.export_logs</attribute>
        <attribute name="icon">document-save-as-symbolic</attribute>
      </item>
    </section>

    <!-- Очистка логов -->
    <section>
      <item>
        <attribute name="label" translatable="yes">Clear Logs</attribute>
        <attribute name="action">win.clear_logs</attribute>
        <attribute name="icon">edit-clear-all-symbolic</attribute>
      </item>
    </section>
  </menu>

  <template class="VrxxLogWindow" parent="AdwWindow">
    <property name="title" translatable="yes">System Logs</property>
    <property name="default-width">800</property>
    <property name="default-height">500</property>
    <property name="width-request">360</property>
    <property name="height-request">320</property>

    <!-- Адаптивная точка останова: мобильный режим окна логов -->
    <child>
      <object class="AdwBreakpoint">
        <condition>max-width: 500sp</condition>
        <setter object="log_toolbar_view" property="top-bar-style">raised</setter>
      </object>
    </child>

    <property name="content">
      <object class="AdwToolbarView" id="log_toolbar_view">

        <!-- ================================================================= -->
        <!-- 1. ВЕРХНЯЯ ПАНЕЛЬ ИНСТРУМЕНТОВ (HEADERBAR)                        -->
        <!-- ================================================================= -->
        <child type="top">
          <object class="AdwHeaderBar">
            <property name="title-widget">
              <object class="AdwWindowTitle">
                <property name="title" translatable="yes">System Logs</property>
              </object>
            </property>

            <!-- Переключатель автоматической прокрутки вниз при новых событиях -->
            <child type="start">
              <object class="GtkToggleButton" id="btn_autoscroll">
                <property name="icon-name">go-down-symbolic</property>
                <property name="tooltip-text" translatable="yes">Auto-scroll</property>
                <property name="active">True</property>
                <style>
                  <class name="flat"/>
                </style>
              </object>
            </child>

            <!-- Выпадающий список фильтрации по источнику (All, Core, App, Access) -->
            <child type="start">
              <object class="GtkDropDown" id="dropdown_filter">
                <property name="tooltip-text" translatable="yes">Filter by source</property>
              </object>
            </child>

            <!-- Выпадающий список фильтрации по уровню (All, Error, Warn, Info, Debug) -->
            <child type="start">
              <object class="GtkDropDown" id="dropdown_level">
                <property name="tooltip-text" translatable="yes">Filter by log level</property>
              </object>
            </child>

            <!-- Кнопка быстрой очистки логов -->
            <child type="end">
              <object class="GtkButton" id="btn_clear">
                <property name="icon-name">edit-clear-all-symbolic</property>
                <property name="tooltip-text" translatable="yes">Clear Logs</property>
                <property name="action-name">win.clear_logs</property>
                <style>
                  <class name="flat"/>
                </style>
              </object>
            </child>

            <!-- Кнопка вызова контекстного меню окна логов -->
            <child type="end">
              <object class="GtkMenuButton" id="menu_btn">
                <property name="icon-name">open-menu-symbolic</property>
                <property name="tooltip-text" translatable="yes">Menu</property>
                <property name="primary">True</property>
                <property name="popover">
                  <object class="GtkPopoverMenu">
                    <property name="menu-model">log_menu</property>
                    <!-- Виджет регулировки масштаба шрифта логов -->
                    <child type="zoom-row">
                      <object class="GtkBox" id="zoom_controls">
                        <property name="orientation">horizontal</property>
                        <property name="homogeneous">True</property>
                        <property name="margin-start">6</property>
                        <property name="margin-end">6</property>
                        <property name="margin-top">3</property>
                        <property name="margin-bottom">3</property>
                        <property name="spacing">6</property>
                        <!-- Уменьшить шрифт -->
                        <child>
                          <object class="GtkButton">
                            <property name="action-name">win.zoom_out</property>
                            <property name="icon-name">zoom-out-symbolic</property>
                            <property name="tooltip-text" translatable="yes">Zoom Out</property>
                            <style>
                              <class name="circular"/>
                              <class name="flat"/>
                            </style>
                          </object>
                        </child>
                        <!-- Сбросить к 100% -->
                        <child>
                          <object class="GtkButton" id="btn_zoom_normal">
                            <property name="action-name">win.zoom_normal</property>
                            <property name="tooltip-text" translatable="yes">Reset Zoom</property>
                            <style>
                              <class name="flat"/>
                              <class name="numeric"/>
                            </style>
                            <property name="child">
                              <object class="GtkLabel" id="zoom_label">
                                <property name="label">100%</property>
                                <property name="width-chars">5</property>
                              </object>
                            </property>
                          </object>
                        </child>
                        <!-- Увеличить шрифт -->
                        <child>
                          <object class="GtkButton">
                            <property name="action-name">win.zoom_in</property>
                            <property name="icon-name">zoom-in-symbolic</property>
                            <property name="tooltip-text" translatable="yes">Zoom In</property>
                            <style>
                              <class name="circular"/>
                              <class name="flat"/>
                            </style>
                          </object>
                        </child>
                      </object>
                    </child>
                  </object>
                </property>
              </object>
            </child>

            <!-- Кнопка открытия строки поиска (Ctrl+F) -->
            <child type="end">
              <object class="GtkToggleButton" id="btn_search">
                <property name="icon-name">edit-find-symbolic</property>
                <property name="tooltip-text" translatable="yes">Search Logs (Ctrl+F)</property>
                <style>
                  <class name="flat"/>
                </style>
              </object>
            </child>
          </object>
        </child>

        <!-- ================================================================= -->
        <!-- 2. ПАНЕЛЬ ПОИСКА ПО ТЕКСТУ ЛОГОВ (SEARCH BAR)                     -->
        <!-- ================================================================= -->
        <child type="top">
          <object class="GtkSearchBar" id="search_bar">
            <property name="search-mode-enabled" bind-source="btn_search" bind-property="active" bind-flags="bidirectional"/>
            <property name="child">
              <object class="AdwClamp">
                <property name="maximum-size">450</property>
                <property name="tightening-threshold">300</property>
                <property name="child">
                  <object class="GtkSearchEntry" id="search_entry">
                    <property name="placeholder-text" translatable="yes">Search logs…</property>
                    <property name="hexpand">True</property>
                  </object>
                </property>
              </object>
            </property>
          </object>
        </child>

        <!-- ================================================================= -->
        <!-- 3. ОБЛАСТЬ ВЫВОДА ТЕКСТА ЛОГОВ (TEXT VIEW)                        -->
        <!-- ================================================================= -->
        <property name="content">
          <object class="GtkScrolledWindow" id="scrolled_window">
            <property name="child">
              <object class="GtkTextView" id="text_view">
                <property name="editable">False</property>
                <property name="cursor-visible">False</property>
                <property name="monospace">True</property>
                <property name="left-margin">12</property>
                <property name="right-margin">12</property>
                <property name="top-margin">12</property>
                <property name="bottom-margin">12</property>
                <style>
                  <class name="view"/>
                </style>
              </object>
            </property>
          </object>
        </property>

      </object>
    </property>
  </template>
</interface>