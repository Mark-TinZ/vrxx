<interface domain="vrxx">
  <!--
    ============================================================================
    ГЛАВНОЕ МЕНЮ ПРИЛОЖЕНИЯ (primary_menu)
    ============================================================================

    СТРУКТУРА МЕНЮ:
    ┌──────────────────────────────────────────────────────────────────────────┐
    │ Секция 1: [theme_switcher] (Кастомный слот переключателя темы)           │
    ├──────────────────────────────────────────────────────────────────────────┤
    │ Секция 2:                                                                │
    │ ├─ Preferences        (app.preferences: Перейти в настройки)            │
    │ ├─ Keyboard Shortcuts (app.shortcuts: Диалог горячих клавиш)             │
    │ ├─ About Vrxx         (app.about: Диалог сведений о программе)          │
    │ ├─ Close Window       (app.close_window: Закрыть только окно интерфейса) │
    │ └─ Quit               (app.quit: Полный выход с подтверждением и стопом) │
    └──────────────────────────────────────────────────────────────────────────┘
  -->

  <menu id="primary_menu">
    <!-- Секция 1: Кастомный виджет выбора цветовой схемы (VrxxThemeSwitcher) -->
    <section>
      <item>
        <attribute name="custom">theme_switcher</attribute>
      </item>
    </section>

    <!-- Секция 2: Стандартные действия приложения -->
    <section>
      <!-- Настройки -->
      <item>
        <attribute name="label" translatable="yes">_Preferences</attribute>
        <attribute name="action">app.preferences</attribute>
      </item>
      <!-- Горячие клавиши -->
      <item>
        <attribute name="label" translatable="yes">_Keyboard Shortcuts</attribute>
        <attribute name="action">app.shortcuts</attribute>
      </item>
      <!-- О программе -->
      <item>
        <attribute name="label" translatable="yes">_About Vrxx</attribute>
        <attribute name="action">app.about</attribute>
      </item>
      <!-- Закрыть окно (GUI) -->
      <item>
        <attribute name="label" translatable="yes">_Close Window</attribute>
        <attribute name="action">app.close_window</attribute>
      </item>
      <!-- Полный выход (GUI + демон) -->
      <item>
        <attribute name="label" translatable="yes">_Quit</attribute>
        <attribute name="action">app.quit</attribute>
      </item>
    </section>
  </menu>
</interface>
