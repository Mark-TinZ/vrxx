<interface domain="vrxx">
  <!--
    ============================================================================
    ДИАЛОГ ИМПОРТА VPN-ПРОФИЛЯ (VrxxImportDialog)
    ============================================================================
  -->
  <template class="VrxxImportDialog" parent="AdwDialog">
    <property name="title" translatable="yes">Import VPN Key</property>
    <property name="content-width">500</property>
    <property name="content-height">540</property>
    <property name="width-request">360</property>
    <property name="height-request">360</property>
    <property name="presentation-mode">auto</property>

    <!-- Адаптивная точка останова: мобильный/компактный режим -->
    <child>
      <object class="AdwBreakpoint">
        <condition>max-width: 500sp</condition>
        <setter object="toolbar_view" property="top-bar-style">raised</setter>
        <setter object="btn_import_connect" property="label" translatable="yes">Connect</setter>
      </object>
    </child>

    <property name="child">
      <object class="AdwToolbarView" id="toolbar_view">
        <child type="top">
          <object class="AdwHeaderBar">
            <property name="title-widget">
              <object class="AdwWindowTitle" id="dialog_title">
                <property name="title" translatable="yes">Import VPN Key</property>
              </object>
            </property>

            <child type="start">
              <object class="GtkButton" id="btn_cancel">
                <property name="label" translatable="yes">Cancel</property>
              </object>
            </child>

            <child type="end">
              <object class="GtkButton" id="btn_import_connect">
                <property name="label" translatable="yes">Import and Connect</property>
                <style>
                  <class name="suggested-action"/>
                </style>
              </object>
            </child>

            <child type="end">
              <object class="GtkButton" id="btn_import">
                <property name="label" translatable="yes">Import</property>
              </object>
            </child>
          </object>
        </child>

        <property name="content">
          <object class="AdwPreferencesPage">
            <!-- Основная информация -->
            <child>
              <object class="AdwPreferencesGroup">
                <property name="title" translatable="yes">General</property>

                <child>
                  <object class="AdwEntryRow" id="entry_name">
                    <property name="title" translatable="yes">Profile Name</property>
                  </object>
                </child>

                <child>
                  <object class="AdwActionRow" id="row_protocol">
                    <property name="title" translatable="yes">Protocol</property>
                  </object>
                </child>
              </object>
            </child>

            <!-- Параметры подключения -->
            <child>
              <object class="AdwPreferencesGroup">
                <property name="title" translatable="yes">Server Connection</property>

                <child>
                  <object class="AdwActionRow" id="row_host">
                    <property name="title" translatable="yes">Host</property>
                  </object>
                </child>

                <child>
                  <object class="AdwActionRow" id="row_port">
                    <property name="title" translatable="yes">Port</property>
                  </object>
                </child>

                <child>
                  <object class="AdwActionRow" id="row_latency">
                    <property name="title" translatable="yes">Latency</property>
                    <property name="subtitle" translatable="yes">Testing...</property>
                    <child type="suffix">
                      <object class="GtkSpinner" id="spinner_latency">
                        <property name="spinning">True</property>
                      </object>
                    </child>
                  </object>
                </child>
              </object>
            </child>

            <!-- Параметры безопасности и TLS -->
            <child>
              <object class="AdwPreferencesGroup" id="group_security">
                <property name="title" translatable="yes">Security and Parameters</property>

                <child>
                  <object class="AdwActionRow" id="row_security">
                    <property name="title" translatable="yes">Security Mode</property>
                    <property name="visible">False</property>
                  </object>
                </child>

                <child>
                  <object class="AdwActionRow" id="row_sni">
                    <property name="title" translatable="yes">SNI / Server Name</property>
                    <property name="visible">False</property>
                  </object>
                </child>

                <child>
                  <object class="AdwActionRow" id="row_fingerprint">
                    <property name="title" translatable="yes">TLS Fingerprint</property>
                    <property name="visible">False</property>
                  </object>
                </child>

                <child>
                  <object class="AdwActionRow" id="row_flow">
                    <property name="title" translatable="yes">Flow</property>
                    <property name="visible">False</property>
                  </object>
                </child>
              </object>
            </child>
          </object>
        </property>
      </object>
    </property>
  </template>
</interface>
