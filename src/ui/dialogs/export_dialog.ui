<interface domain="vrxx">
  <!--
    ============================================================================
    ДИАЛОГ ЭКСПОРТА КОНФИГУРАЦИИ (VrxxExportDialog)
    ============================================================================
  -->
  <template class="VrxxExportDialog" parent="AdwDialog">
    <property name="title" translatable="yes">Export Configuration</property>
    <property name="content-width">460</property>
    <property name="content-height">400</property>
    <property name="width-request">360</property>
    <property name="height-request">300</property>
    <property name="presentation-mode">auto</property>

    <!-- Адаптивная точка останова: мобильный/компактный режим -->
    <child>
      <object class="AdwBreakpoint">
        <condition>max-width: 500sp</condition>
        <setter object="toolbar_view" property="top-bar-style">raised</setter>
      </object>
    </child>

    <property name="child">
      <object class="AdwToolbarView" id="toolbar_view">
        <child type="top">
          <object class="AdwHeaderBar">
            <property name="title-widget">
              <object class="AdwWindowTitle" id="dialog_title">
                <property name="title" translatable="yes">Export Configuration</property>
              </object>
            </property>

            <child type="start">
              <object class="GtkButton" id="btn_cancel">
                <property name="label" translatable="yes">Cancel</property>
              </object>
            </child>

            <child type="end">
              <object class="GtkButton" id="btn_export">
                <property name="label" translatable="yes">Export</property>
                <style>
                  <class name="suggested-action"/>
                </style>
              </object>
            </child>
          </object>
        </child>

        <property name="content">
          <object class="AdwPreferencesPage">
            <child>
              <object class="AdwPreferencesGroup">
                <property name="title" translatable="yes">Export Components</property>
                <property name="description" translatable="yes">Select the components you want to export to a file.</property>

                <!-- Чекбокс: Настройки приложения -->
                <child>
                  <object class="AdwSwitchRow" id="switch_settings">
                    <property name="title" translatable="yes">Application Settings</property>
                    <property name="subtitle" translatable="yes">Theme, interface language, proxy ports, DNS parameters, and routing rules</property>
                    <property name="active">True</property>
                  </object>
                </child>

                <!-- Чекбокс: VPN-профили и ключи -->
                <child>
                  <object class="AdwSwitchRow" id="switch_keys">
                    <property name="title" translatable="yes">VPN Profiles and Keys</property>
                    <property name="subtitle" translatable="yes">Saved servers, connection links, private keys, and credentials</property>
                    <property name="active">False</property>
                  </object>
                </child>
              </object>
            </child>
          </object>
        </property>
      </object>
    </property>
  </template>
</interface>
