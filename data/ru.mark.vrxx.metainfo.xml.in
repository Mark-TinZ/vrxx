<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>ru.mark.vrxx</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>MPL-2.0</project_license>

  <name>Vrxx</name>
  <summary>Sing-box VPN and Proxy Client</summary>
  <description>
    <p>A native Linux GTK4 and Libadwaita graphical interface for sing-box designed to simplify VPN and proxy configuration.</p>
  </description>

  <url type="homepage">https://github.com/Mark-TinZ/vrxx</url>
  <url type="bugtracker">https://github.com/Mark-TinZ/vrxx/issues</url>
  <url type="vcs-browser">https://github.com/Mark-TinZ/vrxx</url>

  <developer id="ru.mark">
    <name>Mark</name>
  </developer>

  <translation type="gettext">vrxx</translation>
  <launchable type="desktop-id">ru.mark.vrxx.desktop</launchable>
  <content_rating type="oars-1.1" />

  <categories>
    <category>Network</category>
    <category>Security</category>
    <category>Utility</category>
  </categories>

  <keywords>
    <keyword>vpn</keyword>
    <keyword>proxy</keyword>
    <keyword>sing-box</keyword>
    <keyword>vless</keyword>
    <keyword>wireguard</keyword>
    <keyword>shadowsocks</keyword>
    <keyword>trojan</keyword>
    <keyword>hysteria2</keyword>
    <keyword>tuic</keyword>
    <keyword>socks5</keyword>
    <keyword>gtk4</keyword>
    <keyword>libadwaita</keyword>
  </keywords>

  <provides>
    <binary>vrxx</binary>
    <binary>vrxx-tui</binary>
  </provides>

  <screenshots>
    <screenshot type="default">
      <image type="source">https://raw.githubusercontent.com/Mark-TinZ/vrxx/main/data/screenshots/main-window.png</image>
      <caption>VRXX Main Window with active VPN connection</caption>
    </screenshot>
    <screenshot>
      <image type="source">https://raw.githubusercontent.com/Mark-TinZ/vrxx/main/data/screenshots/settings.png</image>
      <caption>VRXX Advanced Routing and Network Core Settings</caption>
    </screenshot>
  </screenshots>

  <branding>
    <color type="primary" scheme_preference="light">#3584e4</color>
    <color type="primary" scheme_preference="dark">#1c71d8</color>
  </branding>

  <releases>
    <release version="26.1.0-beta.3" date="2026-09-23">
      <description translate="no">
        <p>Release 26.1.0-beta.3</p>
        <ul>
          <li>Enterprise-grade structured tracing with runtime log level reload, PII sanitization, and 7-day retention</li>
          <li>Fix GNOME system proxy bug: automatic deactivation on disconnect and in TUN mode with startup self-healing</li>
          <li>Full keyboard shortcuts and window accelerators (Disconnect, Ping, Zoom, Settings)</li>
          <li>Declarative dialog architecture (.ui templates under src/ui/dialogs/)</li>
          <li>Mobile adaptivity for small screens with bottom-sheet presentation and responsive clamping</li>
          <li>Dynamic protocol form adaptation in KeyDialog (WireGuard, Shadowsocks, TUIC, Hysteria2, SOCKS5, HTTP)</li>
          <li>Ping All Keys action, startup auto-ping, and configurable background cooldown timer</li>
        </ul>
      </description>
    </release>
    <release version="26.1.0-beta.2" date="2026-08-30">
      <description translate="no">
        <p>Release 26.1.0-beta.2</p>
        <ul>
          <li>Fix TUN startup device busy conflict with sing-box auto_route</li>
          <li>Split GUI close and application quit with confirmation dialog</li>
          <li>Standardize all internal logs in English with level color tags</li>
          <li>Modernize install and uninstall scripts with automatic privilege elevation</li>
        </ul>
      </description>
    </release>
    <release version="26.1.0-beta.1" date="2026-08-28">
      <description translate="no">
        <p>Release 26.1.0-beta.1</p>
        <ul>
          <li>Advanced routing rules and rule-set integration</li>
          <li>System proxy auto-configuration with desktop environment fallbacks</li>
          <li>Encrypted host-bound profile keystore</li>
          <li>Real-time traffic monitor and SSE daemon event streaming</li>
        </ul>
      </description>
    </release>
  </releases>

</component>

